@using Vaka.Web.Services
@using Vaka.Web.ViewModels.Reports
@model MaterialTraceViewModel
@{
    ViewData["Title"] = "Malzeme izlenebilirliği";
    ViewData["Lead"] = "Bir lotun hangi kayıtlarda kullanıldığını ya da bir makinede hangi malzemelerin kullanıldığını sorgulayın.";
    ViewData["NavKey"] = "report-materials";

    var isLot = Model.Mode == MaterialTraceMode.Lot;
    var fromText = Model.From?.ToString("yyyy-MM-dd") ?? "";
    var toText = Model.To?.ToString("yyyy-MM-dd") ?? "";
    var hasRange = Model.From is not null || Model.To is not null;
    var queried = Model.HasResult;
    var selectedLotLabel = Model.SelectedLotLabel ?? "Seçilen lot";
    var selectedMachine = Model.Machines.FirstOrDefault(machine => machine.Id == Model.MachineId);

    string ModeText(MaterialTraceMode mode, string fallback) =>
        Model.ModeOptions.FirstOrDefault(option => option.Id == (int)mode)?.Label ?? fallback;

    string LotLabel(string name, string code, string lotNo, DateOnly expiry, bool expired) =>
        name + " (" + code + "), lot " + lotNo + ", SKT " + expiry.ToString("dd.MM.yyyy") + (expired ? ", SKT geçmiş" : "");
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="notice notice-danger mb-5" role="alert" tabindex="-1" data-form-summary>
        <svg class="icon mt-0.5" aria-hidden="true"><use href="/lib/icons/Icons.svg#circle-alert" /></svg>
        <div class="min-w-0">
            <p class="font-semibold">Rapor hazırlanamadı</p>
            <p class="mt-0.5 text-sm">@Model.ErrorMessage</p>
        </div>
    </div>
}

<nav class="mb-5 flex flex-wrap gap-2" aria-label="Sorgu türü">
    <a class="btn @(isLot ? "btn-primary" : "btn-secondary")" href="/reports/materials?mode=Lot" aria-current="@(isLot ? "page" : null)">@ModeText(MaterialTraceMode.Lot, "Lota göre")</a>
    <a class="btn @(isLot ? "btn-secondary" : "btn-primary")" href="/reports/materials?mode=Machine" aria-current="@(isLot ? null : "page")">@ModeText(MaterialTraceMode.Machine, "Makineye göre")</a>
</nav>

@if (isLot)
{
    <section class="panel mb-5" aria-labelledby="lot-form-title">
        <div class="panel-head"><h2 id="lot-form-title" class="panel-title">Lota göre sorgu</h2></div>
        <div class="space-y-5 p-4 md:p-5">
            <form method="get" action="/reports/materials" aria-label="Lot ara" class="space-y-2">
                <input type="hidden" name="mode" value="Lot" />
                <div class="field">
                    <label class="field-label" for="LotQuery">1. Lotu bulun: malzeme adı, kodu ya da lot no</label>
                    <div class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start">
                        <input id="LotQuery" name="LotQuery" type="search" class="input" value="@Model.LotQuery" autocomplete="off" spellcheck="false" inputmode="search" />
                        <button type="submit" class="btn btn-secondary min-h-12">
                            <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#search" /></svg>
                            Lotları bul
                        </button>
                    </div>
                    <p class="field-hint">Boş bırakırsanız ilk 50 lot listelenir.</p>
                </div>
            </form>

            @if (Model.LotOptions.Length == 0)
            {
                <p class="border-t-2 border-line pt-5 text-muted">Önce yukarıdan lot arayın. Bulunan lotlar burada seçilir.</p>
            }
            else
            {
                <form method="get" action="/reports/materials" aria-label="Lot sorgusu" class="border-t-2 border-line pt-5" data-busy-form>
                    <input type="hidden" name="mode" value="Lot" />
                    @if (!string.IsNullOrWhiteSpace(Model.LotQuery))
                    {
                        <input type="hidden" name="LotQuery" value="@Model.LotQuery" />
                    }
                    @if (Model.LotOptionsTruncated)
                    {
                        <p class="notice notice-warn mb-4"><svg class="icon mt-0.5" aria-hidden="true"><use href="/lib/icons/Icons.svg#info" /></svg><span>Aramayı daraltın. Yalnız ilk 50 lot gösteriliyor.</span></p>
                    }
                    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)_auto]">
                        <div class="field sm:col-span-2 xl:col-span-1">
                            <label class="field-label" for="MaterialLotId">2. Lotu seçin</label>
                            <div class="select-wrap">
                                <select id="MaterialLotId" name="MaterialLotId" class="input" required>
                                    <option value="">Lot seçin</option>
                                    @foreach (var lot in Model.LotOptions)
                                    {
                                        <option value="@lot.Id" selected="@(lot.Id == Model.MaterialLotId)">@LotLabel(lot.MaterialName, lot.MaterialCode, lot.LotNo, lot.ExpiryDate, lot.IsExpired)</option>
                                    }
                                </select>
                                <svg class="icon select-arrow" aria-hidden="true"><use href="/lib/icons/Icons.svg#chevron-down" /></svg>
                            </div>
                        </div>
                        <div class="field">
                            <label class="field-label" for="lot-from">Açılış, başlangıç</label>
                            <input id="lot-from" name="from" type="date" class="input" value="@fromText" autocomplete="off" />
                        </div>
                        <div class="field">
                            <label class="field-label" for="lot-to">Açılış, bitiş</label>
                            <input id="lot-to" name="to" type="date" class="input" value="@toText" autocomplete="off" />
                        </div>
                        <div class="flex items-end sm:col-span-2 xl:col-span-1">
                            <button type="submit" class="btn btn-primary min-h-12 max-sm:w-full">
                                <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#route" /></svg>
                                Sorgula
                            </button>
                        </div>
                    </div>
                </form>
            }
        </div>
    </section>
}
else
{
    <form method="get" action="/reports/materials" class="panel mb-5" aria-label="Makine sorgusu" data-busy-form>
        <input type="hidden" name="mode" value="Machine" />
        <div class="grid gap-4 p-4 sm:grid-cols-2 md:p-5 xl:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)_auto]">
            <div class="field sm:col-span-2 xl:col-span-1">
                <label class="field-label" for="MachineId">Makine</label>
                <div class="select-wrap">
                    <select id="MachineId" name="MachineId" class="input" required>
                        <option value="">Makine seçin</option>
                        @foreach (var machine in Model.Machines)
                        {
                            <option value="@machine.Id" selected="@(machine.Id == Model.MachineId)">@machine.Label</option>
                        }
                    </select>
                    <svg class="icon select-arrow" aria-hidden="true"><use href="/lib/icons/Icons.svg#chevron-down" /></svg>
                </div>
            </div>
            <div class="field">
                <label class="field-label" for="machine-from">Giriş, başlangıç</label>
                <input id="machine-from" name="from" type="date" class="input" value="@fromText" autocomplete="off" />
            </div>
            <div class="field">
                <label class="field-label" for="machine-to">Giriş, bitiş</label>
                <input id="machine-to" name="to" type="date" class="input" value="@toText" autocomplete="off" />
            </div>
            <div class="flex items-end sm:col-span-2 xl:col-span-1">
                <button type="submit" class="btn btn-primary min-h-12 max-sm:w-full">
                    <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#route" /></svg>
                    Sorgula
                </button>
            </div>
        </div>
    </form>
}

<partial name="_ListSkeleton" />

<div data-loading-target>
    @if (!queried)
    {
        <partial name="_State" model='("empty", "route", isLot ? "Bir lot seçin" : "Bir makine seçin", isLot ? "Lotu bulup seçtiğinizde kullanıldığı kayıtlar makine, tarih ve durumla listelenir." : "Makineyi seçtiğinizde orada kullanılan malzemeler ve lotlar tarih sırasıyla listelenir.", (string?)null, (string?)null)' />
    }
    else if (isLot)
    {
        if (Model.LotUsages.Length == 0)
        {
            <partial name="_State" model='("empty", "search", "Bu lot kullanılmamış", hasRange ? "Seçilen tarih aralığında lotun kullanıldığı kayıt yok. Aralığı genişletin." : "Seçilen lot hiçbir kayıtta kullanılmamış.", hasRange ? "Aralığı temizle" : null, hasRange ? "/reports/materials?mode=Lot&LotQuery=" + Uri.EscapeDataString(Model.LotQuery ?? "") + "&MaterialLotId=" + Model.MaterialLotId : null)' />
        }
        else
        {
            <section class="panel" aria-labelledby="usage-title">
                <div class="panel-head">
                    <h2 id="usage-title" class="panel-title break-words">@selectedLotLabel</h2>
                    <p class="text-sm text-muted"><span class="mono font-bold">@Model.LotUsages.Length</span> kayıtta kullanıldı</p>
                </div>
                <table class="data-table table-stack">
                    <caption class="sr-only">Lotun kullanıldığı kayıtlar</caption>
                    <thead>
                        <tr>
                            <th scope="col">Kayıt no</th>
                            <th scope="col">Makine</th>
                            <th scope="col">Açılış</th>
                            <th scope="col">Durum</th>
                            <th scope="col">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var usage in Model.LotUsages)
                        {
                            <tr>
                                <td data-label="" class="stack-lead"><span class="record-no text-sm xl:whitespace-nowrap">@usage.RecordNo</span></td>
                                <td data-label="Makine" class="stack-wide break-words font-semibold">@usage.MachineLabel</td>
                                <td data-label="Açılış"><partial name="_Moment" model='(usage.OpenedAtLocal, DateTime.MinValue)' /></td>
                                <td data-label="Durum" class="stack-badge">
                                    <div class="flex flex-wrap items-center justify-end gap-2">
                                        <partial name="_Badge" model='"record|" + usage.StatusLabel' />
                                        @if (usage.ExpiredAtEntry)
                                        {
                                            <partial name="_Badge" model='"lot.expired"' />
                                        }
                                    </div>
                                </td>
                                <td data-label="İşlem" class="cell-action">
                                    <a class="btn btn-secondary" href="@usage.Url" data-busy-link aria-label="@usage.RecordNo kaydının ayrıntısı">
                                        <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#file-text" /></svg>
                                        Ayrıntı
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }
    }
    else
    {
        if (Model.MachineMaterials.Length == 0)
        {
            <partial name="_State" model='("empty", "search", "Bu makinede malzeme girişi yok", hasRange ? "Seçilen tarih aralığında bu makinede malzeme kullanılmamış. Aralığı genişletin." : "Bu makinedeki kayıtlarda malzeme girilmemiş.", hasRange ? "Aralığı temizle" : null, hasRange ? "/reports/materials?mode=Machine&MachineId=" + Model.MachineId : null)' />
        }
        else
        {
            <section class="panel" aria-labelledby="machine-usage-title">
                <div class="panel-head">
                    <h2 id="machine-usage-title" class="panel-title break-words">@(selectedMachine?.Label ?? "Seçilen makine")</h2>
                    <p class="text-sm text-muted"><span class="mono font-bold">@Model.MachineMaterials.Length</span> malzeme girişi, tarih sırasıyla</p>
                </div>
                <table class="data-table table-stack">
                    <caption class="sr-only">Makinede kullanılan malzemeler ve lotlar</caption>
                    <thead>
                        <tr>
                            <th scope="col">Giriş</th>
                            <th scope="col">Malzeme</th>
                            <th scope="col">Kayıt no</th>
                            <th scope="col">Lot no</th>
                            <th scope="col">SKT</th>
                            <th scope="col">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.MachineMaterials)
                        {
                            <tr>
                                <td data-label=""><partial name="_Moment" model='(item.EnteredAtLocal, DateTime.MinValue)' /></td>
                                <td data-label="Malzeme" class="stack-lead break-words">
                                    <span class="font-semibold">@item.MaterialName</span>
                                    <span class="mono mt-0.5 block text-xs text-muted">@item.MaterialCode</span>
                                </td>
                                <td data-label="Kayıt no"><span class="record-no text-sm xl:whitespace-nowrap">@item.RecordNo</span></td>
                                <td data-label="Lot no" class="mono break-all">@item.LotNo</td>
                                <td data-label="SKT">
                                    <span class="mono whitespace-nowrap">@item.ExpiryDate.ToString("dd.MM.yyyy")</span>
                                    @if (item.ExpiredAtEntry)
                                    {
                                        <span class="mt-1 block"><partial name="_Badge" model='"lot.expired"' /></span>
                                    }
                                </td>
                                <td data-label="İşlem" class="cell-action">
                                    <a class="btn btn-secondary" href="@item.Url" data-busy-link aria-label="@item.RecordNo kaydının ayrıntısı">
                                        <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#file-text" /></svg>
                                        Ayrıntı
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }
    }
</div>

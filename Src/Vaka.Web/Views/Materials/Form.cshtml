@using Vaka.Web.ViewModels.Definitions
@model MaterialFormViewModel
@{
    var isCreate = Model.Id is null;
    ViewData["Title"] = isCreate ? "Malzeme ekle" : "Malzemeyi düzenle";
    ViewData["Lead"] = isCreate ? "Malzemeyi ekledikten sonra lotlarını girin." : Model.Name + ", kod " + Model.Code;
    ViewData["NavKey"] = "materials";
}

<partial name="_FormSummary" model='isCreate ? "Malzeme eklenemedi" : "Malzeme kaydedilemedi"' />

<div class="grid items-start gap-5 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <form method="post" class="panel min-w-0" data-validate data-busy-form data-unsaved-guard aria-labelledby="material-form-title" asp-antiforgery="true">
        <div class="panel-head">
            <h2 id="material-form-title" class="panel-title">Malzeme bilgileri</h2>
        </div>
        <div class="panel-body space-y-6">
            <div class="grid gap-5 md:grid-cols-2">
                <partial name="_Field" model='("Code", "Kod", Model.Code, "text", "off", "Tire içermez, malzemeler arasında benzersizdir.", true, false)' />
                <partial name="_Field" model='("Name", "Ad", Model.Name, "text", "off", (string?)null, true, false)' />
            </div>

            <label class="choice max-w-md">
                <input type="checkbox" asp-for="IsActive" />
                <span class="min-w-0">
                    <span class="block font-bold">Aktif</span>
                    <span class="mt-0.5 block text-sm text-muted">Pasif malzeme yeni kayıtta seçilemez.</span>
                </span>
            </label>

            <div class="flex flex-wrap items-center gap-3 border-t-2 border-line pt-5">
                <button type="submit" class="btn btn-primary btn-lg" data-requires-online>
                    <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#save" /></svg>
                    @(isCreate ? "Malzemeyi ekle" : "Değişiklikleri kaydet")
                </button>
                <a class="btn btn-secondary btn-lg" href="@(isCreate ? "/materials" : "/materials/details/" + Model.Id)">Vazgeç</a>
            </div>
        </div>
    </form>

    <aside class="min-w-0" aria-label="Bilgi">
        <section class="panel" aria-labelledby="material-help-title">
            <div class="panel-head"><h2 id="material-help-title" class="panel-title">Bilmeniz gerekenler</h2></div>
            <ul class="list-inside list-disc space-y-2 p-4 md:p-5">
                <li>Lot numarası malzeme içinde benzersizdir.</li>
                <li>SKT'si bugünden önce olan lot "SKT geçmiş" olarak işaretlenir.</li>
            </ul>
            @if (!isCreate)
            {
                <div class="border-t-2 border-line p-4 md:p-5">
                    <a class="btn btn-secondary" href="/materials/details/@Model.Id">
                        <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#list" /></svg>
                        Lotları göster
                    </a>
                </div>
            }
        </section>
    </aside>
</div>

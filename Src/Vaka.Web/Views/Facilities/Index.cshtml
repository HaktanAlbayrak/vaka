@using Vaka.Web.ViewModels.Definitions
@model FacilityListViewModel
@{
    ViewData["Title"] = "Tesisler";
    ViewData["Lead"] = "Tesisleri ve altındaki hatları tanımlayın. Kayıt açarken yalnız aktif tesis ve hatlar seçilir.";
    ViewData["NavKey"] = "facilities";
    ViewData["StatusMessage"] = Model.StatusMessage;
}

@section Actions {
    <a class="btn btn-primary" href="/facilities/create">
        <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#plus" /></svg>
        Tesis ekle
    </a>
}

<form method="get" action="/facilities" class="panel mb-5" aria-label="Tesis filtresi" data-busy-form>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 p-4 md:p-5">
        <label class="choice min-h-12 flex-1 sm:max-w-sm sm:flex-none">
            <input type="checkbox" name="showInactive" value="true" checked="@Model.ShowInactive" />
            <span class="font-bold">Pasif tesisleri de göster</span>
        </label>
        <button type="submit" class="btn btn-primary min-h-12">
            <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#funnel" /></svg>
            Filtrele
        </button>
    </div>
</form>

<partial name="_ListSkeleton" />

<div data-loading-target>
    @if (!Model.Items.Any())
    {
        <partial name="_State" model='("empty", "building-2", "Henüz tesis yok", "Tesisler siz ekledikçe burada listelenir. Önce tesisi, sonra hatlarını ve makinelerini tanımlayın.", "Tesis ekle", "/facilities/create")' />
    }
    else
    {
        <div class="panel">
            <table class="data-table table-stack">
                <caption class="sr-only">Tesisler, @Model.Items.Length kayıt</caption>
                <thead>
                    <tr>
                        <th scope="col">Kod</th>
                        <th scope="col">Ad</th>
                        <th scope="col" class="text-right max-xl:text-left">Hat</th>
                        <th scope="col" class="text-right max-xl:text-left">Vardiya</th>
                        <th scope="col">Durum</th>
                        <th scope="col">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td data-label="Kod"><span class="record-no text-sm">@item.Code</span></td>
                            <td data-label="Ad" class="max-w-xs break-words font-semibold stack-wide stack-lead">@item.Name</td>
                            <td data-label="Hat" class="num">@item.LineCount</td>
                            <td data-label="Vardiya" class="num">@item.ShiftCount</td>
                            <td data-label="Durum"><partial name="_Badge" model='item.IsActive ? "def.active" : "def.inactive"' /></td>
                            <td data-label="İşlem" class="cell-action max-md:col-span-2 md:max-xl:col-span-2">
                                <div class="action-row">
                                    <a class="btn btn-secondary" href="/facilities/details/@item.Id" aria-label="@item.Name hatlarını göster">
                                        <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#route" /></svg>
                                        Hatlar
                                    </a>
                                    <a class="btn btn-secondary" href="/facilities/edit/@item.Id" aria-label="@item.Name tesisini düzenle">
                                        <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#pencil" /></svg>
                                        Düzenle
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

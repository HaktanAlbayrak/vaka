@{
    ViewData["Title"] = "Pano";
    ViewData["Lead"] = "Gebze tesisi, bugün 13 Kasım 2026. Açık kayıtlar, bekleyen kararlar ve son 7 günün akışı.";
    ViewData["NavKey"] = "dashboard";
    ViewData["DemoRole"] = Roles.Manager;

    var state = Context.Request.Query["state"].ToString();
    var isEmpty = state == "empty";
    var demoRole = Context.Request.Query["demo"].ToString();
    var demoSuffix = demoRole == "" ? "" : "?demo=" + demoRole;

    var active = new (string No, string Machine, string Owner, string Status, string[] Phases, string Summary, string? Live)[]
    {
        ("GBZ-H1-DLM01-P2026-17", "DLM01 Dolum makinesi", "Murat Çelik", "record.running", new[] { "done", "short", "running", "waiting" }, "Faz 3 / 4 · Deterjanlı yıkama", "41 dk"),
        ("GBZ-H3-PKT08-P2026-23", "PKT08 Paketleme makinesi", "Elif Şahin", "record.running", new[] { "done", "running", "waiting" }, "Faz 2 / 3 · Sökülen parçaların yıkanması", "26 dk"),
        ("GBZ-H2-KRS05-P2026-13", "KRS05 Karıştırıcı", "Burak Yıldız", "record.running", new[] { "running", "waiting", "waiting", "waiting" }, "Faz 1 / 4 · Hazırlık ve söküm", "9 dk"),
        ("GBZ-H3-ETK07-P2026-31", "ETK07 Etiketleme makinesi", "Zeynep Arslan Yıldırım", "record.held", new[] { "done", "running", "waiting" }, "Faz 2 / 3 · Beklemede", "47 dk"),
        ("GBZ-H2-KRS05-P2026-12", "KRS05 Karıştırıcı", "Cemile Özkan", "record.open", new[] { "waiting", "waiting", "waiting", "waiting" }, "Henüz adım başlamadı · Kilit 11:45'e kadar", null),
    };

    var requests = new (string Kind, string No, string Owner, string Reason, string Age)[]
    {
        ("İptal talebi", "GBZ-H2-DLM04-P2026-9", "Ahmet Tunç", "Makine yanlış seçildi, DLM03 temizlenecekti.", "2 sa önce"),
        ("Yarıda kapatma talebi", "GBZ-H3-PKT08-P2026-23", "Elif Şahin", "Conta değişimi için hat durduruldu.", "54 dk önce"),
        ("Beklemeye alma talebi", "GBZ-H1-DLM01-P2026-17", "Murat Çelik", "Deterjan lotu doğrulaması bekleniyor.", "12 dk önce"),
    };

    var days = new (string Label, int Planned, int Emergency)[]
    {
        ("Cmt 07.11", 4, 0), ("Paz 08.11", 2, 0), ("Pzt 09.11", 9, 1), ("Sal 10.11", 11, 0),
        ("Çar 11.11", 10, 2), ("Per 12.11", 12, 1), ("Bugün", 6, 0),
    };

    var shortPhases = new (string No, string Phase, string Net, string Minimum, string Reason)[]
    {
        ("GBZ-H1-DLM01-P2026-17", "Faz 2 · Ön durulama", "11:05", "15 dk", "Su basıncı düşük, durulama kısaldı."),
        ("GBZ-H1-DLM01-P2026-15", "Faz 4 · Dezenfeksiyon", "09:40", "12 dk", "Dezenfektan bekleme süresi doldu, hat bekletilmedi."),
    };
}

@if (state == "loading")
{
    <div role="status" aria-busy="true">
        <p class="mb-4 font-semibold text-muted">Yükleniyor…</p>
        <div class="space-y-5" aria-hidden="true">
            <div class="skeleton h-28 w-full"></div>
            <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_22rem]">
                <div class="skeleton h-80 w-full"></div>
                <div class="skeleton h-80 w-full"></div>
            </div>
        </div>
    </div>
}
else if (state == "error")
{
    <partial name="_State" model='("error", "triangle-alert", "Pano verisi alınamadı", "Açık kayıtlar ve talepler sunucudan okunamadı. Sayfayı yenileyin. Sorun sürerse kayıtlar listesinden devam edebilirsiniz.", "Yeniden dene", "/prototype/dashboard?state=error")' />
}
else
{
    <section class="panel mb-5 grid divide-y-2 divide-line sm:grid-cols-[1.5fr_1fr_1fr] sm:divide-x-2 sm:divide-y-0" aria-label="Bugünün özeti">
        <div class="p-4 md:p-6">
            <p class="font-display text-6xl font-extrabold leading-none tabular-nums md:text-7xl">@(isEmpty ? 0 : 5)</p>
            <p class="mt-2 text-lg font-bold">açık kayıt</p>
            <p class="text-sm text-muted">@(isEmpty ? "Şu an açık kayıt yok" : "3 devam ediyor · 1 beklemede · 1 açıldı")</p>
        </div>
        <div class="p-4 md:p-6">
            <p class="font-display text-4xl font-extrabold leading-none tabular-nums">@(isEmpty ? 0 : 3)</p>
            <p class="mt-2 font-bold">bekleyen talep</p>
            <p class="text-sm text-muted">@(isEmpty ? "Karar bekleyen talep yok" : "En eskisi 2 sa önce")</p>
        </div>
        <div class="p-4 md:p-6">
            <p class="font-display text-4xl font-extrabold leading-none tabular-nums">@(isEmpty ? 0 : 1)</p>
            <p class="mt-2 font-bold">molada</p>
            <p class="text-sm text-muted">@(isEmpty ? "Açık mola yok" : "Burak Yıldız, 06 dk")</p>
        </div>
    </section>

    <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_22rem]">
        <div class="min-w-0 space-y-5">
            <section class="panel" aria-labelledby="active-title">
                <div class="panel-head">
                    <h2 id="active-title" class="panel-title">Şu an sahada</h2>
                    <span class="text-sm text-muted">Makine, kayıt sahibi ve faz ilerlemesi</span>
                </div>
                @if (isEmpty)
                {
                    <div class="p-4 md:p-5">
                        <partial name="_State" model='("empty", "factory", "Şu an açık kayıt yok", "Operatörler kayıt açtıkça makineler burada listelenir. Geçmiş kayıtlar için Kayıtlar sayfasına bakın.", "Kayıtlara git", "/prototype/records" + demoSuffix)' />
                    </div>
                }
                else
                {
                    <ul class="divide-y divide-line">
                        @foreach (var item in active)
                        {
                            <li class="grid gap-3 px-4 py-4 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:gap-6 md:px-5">
                                <div class="min-w-0 space-y-1">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <p class="font-bold">@item.Machine</p>
                                        <partial name="_Badge" model="item.Status" />
                                    </div>
                                    <p class="record-no text-sm">@item.No</p>
                                    <p class="text-sm text-muted">@item.Owner@(item.Live is null ? "" : " · Net " + item.Live)</p>
                                </div>
                                <partial name="_PhaseTrack" model="(item.Phases, item.Summary)" />
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="panel" aria-labelledby="flow-title">
                <div class="panel-head">
                    <h2 id="flow-title" class="panel-title">Son 7 gün</h2>
                    <span class="text-sm text-muted">Tamamlanan temizlik sayısı</span>
                </div>
                <div class="panel-body">
                    <partial name="_BarChart" model='("Günlük tamamlanan temizlik", days)' />
                </div>
            </section>

            <section class="panel" aria-labelledby="short-title">
                <div class="panel-head">
                    <h2 id="short-title" class="panel-title">Süre altında kapanan fazlar</h2>
                    <span class="text-sm text-muted">Son 7 gün</span>
                </div>
                <ul class="divide-y divide-line">
                    @foreach (var item in shortPhases)
                    {
                        <li class="grid gap-1 px-4 py-3 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:gap-6 md:px-5">
                            <div class="min-w-0">
                                <p class="record-no text-sm">@item.No</p>
                                <p class="font-semibold">@item.Phase</p>
                            </div>
                            <div class="min-w-0 text-sm">
                                <partial name="_Badge" model='"phase.short"' />
                                <p class="mt-1">Net <span class="mono font-bold">@item.Net</span> · minimum @item.Minimum</p>
                                <p class="text-muted">@item.Reason</p>
                            </div>
                        </li>
                    }
                </ul>
            </section>
        </div>

        <aside class="min-w-0 space-y-5" aria-label="Bağlam">
            <section class="panel" aria-labelledby="requests-title">
                <div class="panel-head">
                    <h2 id="requests-title" class="panel-title">Bekleyen talepler</h2>
                    <span class="text-sm text-muted">@(isEmpty ? "0" : "3")</span>
                </div>
                @if (isEmpty)
                {
                    <p class="p-4 text-muted md:p-5">Karar bekleyen talep yok. Operatör talep açınca burada görünür.</p>
                }
                else
                {
                    <ul class="divide-y divide-line">
                        @foreach (var request in requests)
                        {
                            <li class="space-y-1.5 px-4 py-3 md:px-5">
                                <div class="flex flex-wrap items-center justify-between gap-2">
                                    <span class="font-bold">@request.Kind</span>
                                    <partial name="_Badge" model='"request.pending"' />
                                </div>
                                <p class="record-no text-xs">@request.No</p>
                                <p class="text-sm">@request.Reason</p>
                                <p class="text-xs text-muted">@request.Owner · @request.Age</p>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="panel" aria-labelledby="shift-title">
                <div class="panel-head"><h2 id="shift-title" class="panel-title">Vardiya</h2></div>
                <dl class="kv panel-body">
                    <div><dt>Şu anki vardiya</dt><dd>Gündüz, 06:00 - 14:00</dd></div>
                    <div><dt>Vardiya bitişine</dt><dd class="mono">2 sa 52 dk</dd></div>
                    <div><dt>Vardiyası bitmiş açık iş</dt><dd>Yok</dd></div>
                </dl>
            </section>
        </aside>
    </div>
}

<partial name="_DemoBar" model='("state", state, new (string Value, string Text)[] { ("", "Dolu"), ("loading", "Yükleniyor"), ("empty", "Boş"), ("error", "Hata") })' />

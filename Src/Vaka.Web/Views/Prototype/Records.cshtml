@{
    ViewData["Title"] = "Kayıtlar";
    ViewData["Lead"] = "Tüm temizlik kayıtları. Süreler net süredir, molalar düşülmüştür.";
    ViewData["NavKey"] = "records";
    ViewData["DemoRole"] = Roles.Manager;

    var state = Context.Request.Query["state"].ToString();
    var demoRole = Context.Request.Query["demo"].ToString();
    var demoSuffix = demoRole == "" ? "" : "?demo=" + demoRole;
    var pageNo = int.TryParse(Context.Request.Query["page"], out var parsedPage) && parsedPage is >= 1 and <= 12 ? parsedPage : 1;
    var query = Context.Request.Query["q"].ToString();
    var statusFilter = Context.Request.Query["status"].ToString();
    var kindFilter = Context.Request.Query["kind"].ToString();

    var rows = new (string No, string Machine, string Kind, string Owner, string Status, string Opened, string Net, string Effort, string? Warning)[]
    {
        ("GBZ-H1-DLM01-P2026-17", "DLM01 Dolum makinesi", "kind.planned", "Murat Çelik", "record.running", "Bugün 09:12", "41 dk", "1 sa 22 dk", "1 faz süre altında"),
        ("GBZ-H2-KRS05-P2026-12", "KRS05 Karıştırıcı", "kind.planned", "Burak Yıldız", "record.open", "Bugün 11:02", "-", "-", null),
        ("GBZ-H3-ETK07-P2026-31", "ETK07 Ürün temas parçaları yıkama hattı, sarma ve etiketleme makinesi, ikinci istasyon", "kind.planned", "Zeynep Arslan Yıldırım", "record.held", "Bugün 08:20", "47 dk", "47 dk", null),
        ("GBZ-H1-KRS02-P2026-09", "KRS02 Karıştırıcı", "kind.planned", "Murat Çelik", "record.done", "Bugün 07:30", "1 sa 04 dk", "1 sa 04 dk", null),
        ("GBZ-H2-PKT03-A2026-3", "PKT03 Paketleme makinesi", "kind.emergency", "Emre Kaplan", "record.aborted", "Bugün 06:48", "22 dk", "22 dk", null),
        ("GBZ-H1-DLM01-P2026-16", "DLM01 Dolum makinesi", "kind.planned", "Murat Çelik", "record.expired", "Bugün 05:55", "-", "-", null),
        ("GBZ-H1-DLM01-P2026-15", "DLM01 Dolum makinesi", "kind.planned", "Elif Şahin", "record.done", "Dün 14:05", "1 sa 31 dk", "2 sa 58 dk", "1 faz süre altında"),
        ("GBZ-H2-DLM04-P2026-8", "DLM04 Dolum makinesi", "kind.planned", "Ahmet Tunç", "record.cancelled", "Dün 22:10", "-", "-", null),
        ("GBZ-H2-KRS05-A2026-2", "KRS05 Karıştırıcı", "kind.emergency", "Cemile Özkan", "record.done", "Dün 16:44", "18 dk", "36 dk", null),
        ("GBZ-H3-PKT08-P2026-22", "PKT08 Paketleme makinesi", "kind.planned", "Elif Şahin", "record.done", "Dün 09:15", "58 dk", "58 dk", null),
    };

    string PageHref(int target) => "?page=" + target + (query != "" ? "&q=" + Uri.EscapeDataString(query) : "") + (statusFilter != "" ? "&status=" + statusFilter : "") + (kindFilter != "" ? "&kind=" + kindFilter : "") + (demoRole != "" ? "&demo=" + demoRole : "");

    var statusOptions = new (string Value, string Text)[]
    {
        ("", "Tüm durumlar"), ("record.open", "Açıldı"), ("record.running", "Devam ediyor"), ("record.held", "Beklemede"),
        ("record.done", "Tamamlandı"), ("record.expired", "Zaman aşımı"), ("record.cancelled", "İptal edildi"), ("record.aborted", "Yarıda kapatıldı"),
    };
}

<form method="get" action="/prototype/records" class="panel mb-5" aria-label="Kayıt filtresi">
    @if (demoRole != "")
    {
        <input type="hidden" name="demo" value="@demoRole" />
    }
    <div class="grid gap-4 p-4 md:grid-cols-2 md:p-5 xl:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)_auto] xl:items-end">
        <div class="field">
            <label class="field-label" for="q">Kayıt no, makine ya da kişi</label>
            <input id="q" name="q" type="search" class="input" value="@query" autocomplete="off" spellcheck="false" placeholder="Örnek: DLM01" />
        </div>
        <div class="field">
            <label class="field-label" for="status">Durum</label>
            <div class="select-wrap">
                <select id="status" name="status" class="input">
                @foreach (var option in statusOptions)
                {
                    <option value="@option.Value" selected="@(option.Value == statusFilter)">@option.Text</option>
                }
            </select>
                <svg class="icon select-arrow" aria-hidden="true"><use href="/lib/icons/Icons.svg#chevron-down" /></svg>
            </div>
        </div>
        <div class="field">
            <label class="field-label" for="kind">Tür</label>
            <div class="select-wrap">
                <select id="kind" name="kind" class="input">
                <option value="">Planlı ve acil</option>
                <option value="planned" selected="@(kindFilter == "planned")">Planlı</option>
                <option value="emergency" selected="@(kindFilter == "emergency")">Acil</option>
            </select>
                <svg class="icon select-arrow" aria-hidden="true"><use href="/lib/icons/Icons.svg#chevron-down" /></svg>
            </div>
        </div>
        <div class="flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary">
                <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#funnel" /></svg>
                Filtrele
            </button>
            <a class="btn btn-secondary" href="/prototype/records@(demoSuffix)">Filtreleri temizle</a>
        </div>
    </div>
</form>

@if (state == "loading")
{
    <div role="status" aria-busy="true">
        <p class="mb-3 font-semibold text-muted">Yükleniyor…</p>
        <div class="panel divide-y divide-line" aria-hidden="true">
            @for (var index = 0; index < 6; index++)
            {
                <div class="grid grid-cols-[minmax(0,2fr)_minmax(0,3fr)_minmax(0,1fr)] gap-4 p-4">
                    <div class="skeleton h-5 w-full"></div>
                    <div class="skeleton h-5 w-full"></div>
                    <div class="skeleton h-5 w-full"></div>
                </div>
            }
        </div>
    </div>
}
else if (state == "empty")
{
    <partial name="_State" model='("empty", "search", "Filtreye uyan kayıt yok", "Arama ya da süzgeçleri gevşetin. Kayıtlar operatörler kayıt açtıkça burada listelenir.", "Filtreleri temizle", "/prototype/records" + demoSuffix)' />
}
else if (state == "error")
{
    <partial name="_State" model='("error", "triangle-alert", "Kayıtlar alınamadı", "Liste sunucudan okunamadı. Yeniden deneyin. Sorun sürerse sistem yöneticisine bildirin.", "Yeniden dene", "/prototype/records" + demoSuffix)' />
}
else
{
    <div class="panel">
        <div class="overflow-x-auto xl:overflow-visible" data-scroll-x>
            <table class="data-table table-stack" role="table">
                <caption class="sr-only">Temizlik kayıtları, 118 kayıttan @((pageNo - 1) * 10 + 1) ile @(pageNo * 10) arası</caption>
                <thead role="rowgroup">
                    <tr role="row">
                        <th scope="col" role="columnheader">Kayıt no</th>
                        <th scope="col" role="columnheader">Makine</th>
                        <th scope="col" role="columnheader">Tür</th>
                        <th scope="col" role="columnheader">Sahip</th>
                        <th scope="col" role="columnheader">Durum</th>
                        <th scope="col" role="columnheader">Açılış</th>
                        <th scope="col" role="columnheader" class="text-right">Net süre</th>
                        <th scope="col" role="columnheader" class="text-right">Efor</th>
                    </tr>
                </thead>
                <tbody role="rowgroup">
                    @foreach (var row in rows)
                    {
                        <tr role="row">
                            <td role="cell" data-label=""><span class="record-no text-sm xl:whitespace-nowrap">@row.No</span></td>
                            <td role="cell" data-label="Makine" class="stack-wide max-w-xs break-words font-semibold">@row.Machine</td>
                            <td role="cell" data-label="Tür"><partial name="_Badge" model="row.Kind" /></td>
                            <td role="cell" data-label="Sahip" class="max-w-[12rem] break-words">@row.Owner</td>
                            <td role="cell" data-label="Durum">
                                <div class="flex flex-wrap items-center gap-2">
                                    <partial name="_Badge" model="row.Status" />
                                    @if (row.Warning is not null)
                                    {
                                        <span class="chip"><svg class="icon h-4 w-4" aria-hidden="true"><use href="/lib/icons/Icons.svg#triangle-alert" /></svg>@row.Warning</span>
                                    }
                                </div>
                            </td>
                            <td role="cell" data-label="Açılış" class="whitespace-nowrap mono">@row.Opened</td>
                            <td role="cell" data-label="Net süre" class="num whitespace-nowrap">@row.Net</td>
                            <td role="cell" data-label="Efor" class="num whitespace-nowrap">@row.Effort</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pagination" model='(pageNo, 10, 118, "kayıt", (Func<int, string>)PageHref)' />
    </div>
}

<partial name="_DemoBar" model='("state", state, new (string Value, string Text)[] { ("", "Dolu"), ("loading", "Yükleniyor"), ("empty", "Boş"), ("error", "Hata") })' />

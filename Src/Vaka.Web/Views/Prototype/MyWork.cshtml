@{
    ViewData["Title"] = "İşlerim";
    ViewData["Lead"] = "Açık kaydınız ve bugün kapanan işleriniz.";
    ViewData["NavKey"] = "my-work";
    ViewData["DemoRole"] = Roles.Operator;

    var state = Context.Request.Query["state"].ToString();
    var demoRole = Context.Request.Query["demo"].ToString();
    var demoSuffix = demoRole == "" ? "" : "?demo=" + demoRole;

    var today = new[]
    {
        (No: "GBZ-H1-KRS02-P2026-09", Machine: "KRS02 Karıştırıcı", Status: "record.done", Net: "1 sa 04 dk", Note: "Kapandı 08:41"),
        (No: "GBZ-H2-PKT03-A2026-3", Machine: "PKT03 Paketleme makinesi", Status: "record.aborted", Net: "22 dk", Note: "Yönetici kapattı 07:36"),
        (No: "GBZ-H1-DLM01-P2026-16", Machine: "DLM01 Dolum makinesi", Status: "record.expired", Net: "Başlamadı", Note: "Kilit bitişi 06:40"),
        (No: "GBZ-H3-ETK07-P2026-31", Machine: "ETK07 Etiketleme makinesi", Status: "record.held", Net: "47 dk", Note: "Yönetici beklemeye aldı 10:05"),
    };
}

@section Actions {
    @if (state == "empty")
    {
        <a class="btn btn-primary btn-lg" href="/prototype/new-record@(demoSuffix)">
            <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#plus" /></svg>
            Yeni kayıt aç
        </a>
    }
}

@if (state == "loading")
{
    <div role="status" aria-busy="true">
        <p class="mb-4 font-semibold text-muted">Yükleniyor…</p>
        <div class="grid gap-5 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]" aria-hidden="true">
            <div class="panel space-y-4 p-5">
                <div class="skeleton h-6 w-3/5"></div>
                <div class="skeleton h-4 w-2/5"></div>
                <div class="skeleton h-3 w-full"></div>
                <div class="skeleton h-14 w-full"></div>
            </div>
            <div class="panel space-y-4 p-5">
                <div class="skeleton h-5 w-2/5"></div>
                <div class="skeleton h-12 w-full"></div>
                <div class="skeleton h-12 w-full"></div>
                <div class="skeleton h-12 w-full"></div>
            </div>
        </div>
    </div>
}
else if (state == "empty")
{
    <partial name="_State" model='("empty", "clipboard-list", "Açık işiniz yok", "Temizlik yapacağınız makineyi seçip kayıt açın. Bugün kapanan işleriniz burada listelenir.", "Yeni kayıt aç", "/prototype/new-record" + demoSuffix)' />
}
else if (state == "error")
{
    <partial name="_State" model='("error", "triangle-alert", "İşleriniz alınamadı", "Sunucuya ulaşılamadı. Bağlantıyı kontrol edip yeniden deneyin. Sorun sürerse yöneticinize bildirin.", "Yeniden dene", Context.Request.Path.ToString() + demoSuffix)' />
}
else
{
    <div class="grid gap-5 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
        <section class="panel border-accent" aria-labelledby="active-title">
            <div class="panel-head">
                <h2 id="active-title" class="panel-title">Açık iş</h2>
                <div class="flex flex-wrap items-center gap-2">
                    <partial name="_Badge" model='"kind.planned"' />
                    <partial name="_Badge" model='"record.running"' />
                </div>
            </div>
            <div class="panel-body space-y-5">
                <div class="min-w-0">
                    <p class="record-no text-xl md:text-2xl">GBZ-H1-DLM01-P2026-17</p>
                    <p class="mt-1 text-lg font-semibold">DLM01 Dolum makinesi</p>
                    <p class="text-muted">Gebze · Hat 1 · Ürün değişimi temizliği</p>
                </div>
                <partial name="_PhaseTrack" model='(new[] { "done", "short", "running", "waiting" }, "Faz 3 / 4 · Deterjanlı yıkama · Adım 3.2 devam ediyor")' />
                <dl class="kv grid-cols-2">
                    <div>
                        <dt>Net süre</dt>
                        <dd class="mono">41:08</dd>
                    </div>
                    <div>
                        <dt>Açılış</dt>
                        <dd class="mono">09:12</dd>
                    </div>
                </dl>
                <a class="btn btn-primary btn-lg btn-block" href="/prototype/run@(demoSuffix)">
                    Yürütmeye git
                    <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#chevron-right" /></svg>
                </a>
            </div>
        </section>

        <div>
            <section class="panel" aria-labelledby="today-title">
                <div class="panel-head">
                    <h2 id="today-title" class="panel-title">Bugün</h2>
                    <span class="text-sm text-muted">4 kayıt</span>
                </div>
                <ul class="divide-y divide-line">
                    @foreach (var record in today)
                    {
                        <li class="space-y-1.5 px-4 py-3 md:px-5">
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <span class="record-no text-sm">@record.No</span>
                                <partial name="_Badge" model="record.Status" />
                            </div>
                            <p class="font-semibold">@record.Machine</p>
                            <p class="text-sm text-muted">@record.Note · Net <span class="mono">@record.Net</span></p>
                        </li>
                    }
                </ul>
            </section>
        </div>
    </div>
}

<partial name="_DemoBar" model='("state", state, new (string Value, string Text)[] { ("", "Dolu"), ("loading", "Yükleniyor"), ("empty", "Boş"), ("error", "Hata") })' />

@{
    ViewData["Title"] = "Yeni kayıt";
    ViewData["Lead"] = "Makineyi ve temizlik tipini seçin, PIN'inizle kaydı açın.";
    ViewData["NavKey"] = "new-record";
    ViewData["DemoRole"] = Roles.Operator;

    var state = Context.Request.Query["state"].ToString();
    var demoRole = Context.Request.Query["demo"].ToString();
    var demoSuffix = demoRole == "" ? "" : "?demo=" + demoRole;
    var hasErrors = state == "error";
    var pinError = hasErrors ? "PIN'i girin." : null;

    var machineGroups = new (string Place, (string Value, string Text, bool Locked)[] Machines)[]
    {
        ("Gebze · Hat 1", new[] { ("DLM01", "DLM01 Dolum makinesi", false), ("KRS02", "KRS02 Karıştırıcı", false) }),
        ("Gebze · Hat 2", new[] { ("PKT03", "PKT03 Paketleme makinesi", false), ("DLM04", "DLM04 Dolum makinesi, kilitli", true), ("KRS05", "KRS05 Karıştırıcı", false) }),
        ("Gebze · Hat 3", new[] { ("ETK07", "ETK07 Etiketleme makinesi", false) }),
    };

    var types = new (string Value, string Title, string Lock, string Detail)[]
    {
        ("urun-degisimi", "Ürün değişimi temizliği", "Makine 45 dk tutulur", "4 faz, 13 adım · Malzeme gerekli"),
        ("haftalik-derin", "Haftalık derin temizlik", "Makine 60 dk tutulur", "5 faz, 21 adım · Malzeme gerekli"),
        ("vardiya-sonu", "Vardiya sonu hızlı temizlik", "Makine 30 dk tutulur", "2 faz, 6 adım · Malzeme gerekmez"),
    };
}

@if (state == "loading")
{
    <div role="status" aria-busy="true">
        <p class="mb-4 font-semibold text-muted">Yükleniyor…</p>
        <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_22rem]" aria-hidden="true">
            <div class="panel space-y-5 p-5">
                <div class="skeleton h-5 w-1/4"></div>
                <div class="skeleton h-12 w-full"></div>
                <div class="skeleton h-5 w-1/3"></div>
                <div class="skeleton h-16 w-full"></div>
                <div class="skeleton h-16 w-full"></div>
                <div class="skeleton h-14 w-full"></div>
            </div>
            <div class="panel space-y-3 p-5">
                <div class="skeleton h-5 w-1/2"></div>
                <div class="skeleton h-4 w-full"></div>
                <div class="skeleton h-4 w-4/5"></div>
            </div>
        </div>
    </div>
}
else if (state == "empty")
{
    <partial name="_State" model='("empty", "factory", "Kayıt açabileceğiniz makine yok", "Temizlik tipi eşlenmiş aktif makine bulunamadı. Makine ve tip eşlemesini yöneticinizle kontrol edin.", "İşlerime dön", "/prototype/my-work" + demoSuffix)' />
}
else
{
    <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_22rem]">
        <form method="post" class="panel min-w-0" data-validate aria-labelledby="form-title">
            <div class="panel-head">
                <h2 id="form-title" class="panel-title">Kayıt bilgileri</h2>
            </div>
            <div class="panel-body space-y-6">
                <input type="hidden" name="CommandId" value="3b9a6d10-84c2-4f7e-b1a5-0e6d92c7f314" />

                @if (state == "blocked")
                {
                    <div class="notice notice-danger" role="alert">
                        <svg class="icon mt-0.5" aria-hidden="true"><use href="/lib/icons/Icons.svg#lock" /></svg>
                        <div>
                            <p class="font-semibold">Kayıt açılamadı: DLM04 kilitli</p>
                            <p class="mt-0.5 text-sm">Makineyi GBZ-H2-DLM04-P2026-11 numaralı kayıt tutuyor. Kayıt kapanınca ya da kilit bitince makine açılır. Başka bir makine seçin ya da yöneticinize haber verin.</p>
                        </div>
                    </div>
                }
                @if (hasErrors)
                {
                    <div class="notice notice-danger" role="alert">
                        <svg class="icon mt-0.5" aria-hidden="true"><use href="/lib/icons/Icons.svg#circle-alert" /></svg>
                        <div>
                            <p class="font-semibold">Kayıt açılamadı, 4 alanı düzeltin</p>
                            <ul class="mt-1 text-sm">
                                <li><a class="inline-flex min-h-11 min-w-11 items-center underline underline-offset-2" href="#machine">Makine</a></li>
                                <li><a class="inline-flex min-h-11 min-w-11 items-center underline underline-offset-2" href="#type-urun-degisimi">Temizlik tipi</a></li>
                                <li><a class="inline-flex min-h-11 min-w-11 items-center underline underline-offset-2" href="#lot">Lot</a></li>
                                <li><a class="inline-flex min-h-11 min-w-11 items-center underline underline-offset-2" href="#pin-new">PIN</a></li>
                            </ul>
                        </div>
                    </div>
                }

                <div class="field" data-field>
                    <label class="field-label" for="machine">Makine</label>
                    <div class="select-wrap">
                        <select id="machine" name="MachineId" class="input" required data-required-message="Makine seçin."
                            aria-describedby="@(hasErrors ? "machine-hint machine-error" : "machine-hint")" aria-invalid="@(hasErrors ? "true" : null)">
                        <option value="">Makine seçin</option>
                        @foreach (var group in machineGroups)
                        {
                            <optgroup label="@group.Place">
                                @foreach (var machine in group.Machines)
                                {
                                    <option value="@machine.Value" disabled="@(machine.Locked && state != "blocked")" selected="@(state == "blocked" && machine.Value == "DLM04")">@machine.Text</option>
                                }
                            </optgroup>
                        }
                    </select>
                        <svg class="icon select-arrow" aria-hidden="true"><use href="/lib/icons/Icons.svg#chevron-down" /></svg>
                    </div>
                    <p id="machine-hint" class="field-hint">Kilitli makineler seçilemez.</p>
                    @if (hasErrors)
                    {
                        <p id="machine-error" class="field-error">
                            <svg class="icon mt-0.5 h-4 w-4" aria-hidden="true"><use href="/lib/icons/Icons.svg#circle-alert" /></svg>
                            <span>Makine seçin.</span>
                        </p>
                    }
                </div>

                <fieldset class="field" data-field aria-describedby="@(hasErrors ? "type-error" : null)">
                    <legend class="field-label">Temizlik tipi</legend>
                    <div class="grid gap-2">
                        @foreach (var type in types)
                        {
                            <label class="choice">
                                <input type="radio" name="CleaningTypeId" id="type-@type.Value" value="@type.Value" required />
                                <span class="min-w-0">
                                    <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
                                        <span class="font-bold">@type.Title</span>
                                        <partial name="_Badge" model='"kind.planned"' />
                                    </span>
                                    <span class="mt-1 block text-sm text-muted">@type.Lock · @type.Detail</span>
                                </span>
                            </label>
                        }
                    </div>
                    @if (hasErrors)
                    {
                        <p id="type-error" class="field-error">
                            <svg class="icon mt-0.5 h-4 w-4" aria-hidden="true"><use href="/lib/icons/Icons.svg#circle-alert" /></svg>
                            <span>Temizlik tipini seçin.</span>
                        </p>
                    }
                </fieldset>

                <div class="grid gap-5 md:grid-cols-2">
                    <div class="field" data-field>
                        <label class="field-label" for="material">Malzeme</label>
                        <div class="select-wrap">
                            <select id="material" name="MaterialId" class="input" required data-required-message="Malzeme seçin.">
                            <option value="">Malzeme seçin</option>
                            <option value="alkali" selected="@hasErrors">Alkali deterjan</option>
                            <option value="asidik">Asidik deterjan</option>
                            <option value="dezenfektan">Dezenfektan</option>
                        </select>
                            <svg class="icon select-arrow" aria-hidden="true"><use href="/lib/icons/Icons.svg#chevron-down" /></svg>
                        </div>
                        <p class="field-hint">Seçilen tip malzeme gerektiriyor.</p>
                    </div>
                    <div class="field" data-field>
                        <label class="field-label" for="lot">Lot</label>
                        <div class="select-wrap">
                            <select id="lot" name="MaterialLotId" class="input" required data-required-message="Lot seçin."
                                aria-describedby="@(hasErrors ? "lot-hint lot-error" : "lot-hint")" aria-invalid="@(hasErrors ? "true" : null)">
                            <option value="">Lot seçin</option>
                            <option value="DT2411-08">DT2411-08 · SKT 30.04.2027</option>
                            <option value="DT2410-03">DT2410-03 · SKT 31.01.2027</option>
                            <option value="DT2307-02" selected="@hasErrors">DT2307-02 · SKT geçmiş</option>
                        </select>
                            <svg class="icon select-arrow" aria-hidden="true"><use href="/lib/icons/Icons.svg#chevron-down" /></svg>
                        </div>
                        <p id="lot-hint" class="field-hint">Son kullanma tarihi geçmiş lot kullanılamaz.</p>
                        @if (hasErrors)
                        {
                            <p id="lot-error" class="field-error">
                                <svg class="icon mt-0.5 h-4 w-4" aria-hidden="true"><use href="/lib/icons/Icons.svg#circle-alert" /></svg>
                                <span>Bu lotun son kullanma tarihi geçmiş. Başka lot seçin.</span>
                            </p>
                        }
                    </div>
                </div>

                <div class="max-w-xs">
                    <partial name="_PinInput" model='("pin-new", "PIN", "verify", (int?)null, "Pin", pinError)' />
                </div>

                <div class="flex flex-wrap items-center gap-3 border-t-2 border-line pt-5">
                    <button type="submit" class="btn btn-primary btn-lg" data-requires-online>
                        <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#file-plus" /></svg>
                        Kaydı aç
                    </button>
                    <a class="btn btn-secondary btn-lg" href="/prototype/my-work@(demoSuffix)">Vazgeç</a>
                </div>
            </div>
        </form>

        <aside class="min-w-0 space-y-5" aria-label="Kayıt açılınca">
            <section class="panel" aria-labelledby="after-title">
                <div class="panel-head"><h2 id="after-title" class="panel-title">Kayıt açılınca</h2></div>
                <ol class="list-inside list-decimal space-y-3 p-4 md:p-5">
                    <li>Sistem kayıt numarasını ve saha defteri referansını verir.</li>
                    <li>Makine seçtiğiniz tipin kilit süresi kadar sizin için tutulur.</li>
                    <li>Kilit bitmeden ilk adımı başlatın, yoksa kayıt Zaman aşımı olur.</li>
                </ol>
            </section>
            <section class="panel" aria-labelledby="rule-title">
                <div class="panel-head"><h2 id="rule-title" class="panel-title">Tek açık iş</h2></div>
                <p class="p-4 md:p-5">Aynı anda yalnız bir açık kaydınız olabilir. Başka bir kaydınız Açıldı ya da Devam ediyor durumundaysa yeni kayıt açılmaz.</p>
            </section>
        </aside>
    </div>
}

<partial name="_DemoBar" model='("state", state, new (string Value, string Text)[] { ("", "Dolu"), ("error", "Doğrulama hatası"), ("blocked", "Makine kilitli"), ("loading", "Yükleniyor"), ("empty", "Boş") })' />

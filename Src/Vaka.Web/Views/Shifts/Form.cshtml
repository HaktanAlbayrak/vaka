@using Vaka.Web.ViewModels.Definitions
@model ShiftFormViewModel
@{
    var isCreate = Model.Id is null;
    ViewData["Title"] = isCreate ? "Vardiya ekle" : "Vardiyayı düzenle";
    ViewData["Lead"] = Model.FacilityName + (isCreate ? " tesisine yeni vardiya." : ", " + Model.Name);
    ViewData["NavKey"] = "shifts";
}

<partial name="_FormSummary" model='isCreate ? "Vardiya eklenemedi" : "Vardiya kaydedilemedi"' />

<div class="grid items-start gap-5 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <form method="post" class="panel min-w-0" data-validate data-busy-form data-unsaved-guard aria-labelledby="shift-form-title">
        <div class="panel-head">
            <h2 id="shift-form-title" class="panel-title">Vardiya bilgileri</h2>
        </div>
        <div class="panel-body space-y-6">
            <input type="hidden" name="FacilityId" value="@Model.FacilityId" />
            <dl class="kv">
                <div><dt>Tesis</dt><dd>@Model.FacilityName</dd></div>
            </dl>

            <div class="max-w-md">
                <partial name="_Field" model='("Name", "Ad", Model.Name, "text", "off", (string?)null, true, false)' />
            </div>

            <div class="grid gap-5 md:grid-cols-2">
                <partial name="_ValueField" model='("StartTime", "Başlangıç", "time", Model.StartTime?.ToString("HH:mm"), "Türkiye saati. Başlangıç dahildir.", "Başlangıç saatini girin.")' />
                <partial name="_ValueField" model='("EndTime", "Bitiş", "time", Model.EndTime?.ToString("HH:mm"), "Başlangıçtan küçükse vardiya ertesi gün biter. Bitiş dahil değildir.", "Bitiş saatini girin.")' />
            </div>

            <label class="choice max-w-md">
                <input type="hidden" name="IsActive" value="false" />
                <input type="checkbox" name="IsActive" value="true" checked="@Model.IsActive" />
                <span class="min-w-0">
                    <span class="block font-bold">Aktif</span>
                    <span class="mt-0.5 block text-sm text-muted">Pasif vardiya çakışma kontrolüne ve süre hesaplarına girmez.</span>
                </span>
            </label>

            <div class="flex flex-wrap items-center gap-3 border-t-2 border-line pt-5">
                <button type="submit" class="btn btn-primary btn-lg" data-requires-online>
                    <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#save" /></svg>
                    @(isCreate ? "Vardiyayı ekle" : "Değişiklikleri kaydet")
                </button>
                <a class="btn btn-secondary btn-lg" href="/shifts?facilityId=@Model.FacilityId">Vazgeç</a>
            </div>
        </div>
    </form>

    <aside class="min-w-0" aria-label="Bilgi">
        <section class="panel" aria-labelledby="shift-help-title">
            <div class="panel-head"><h2 id="shift-help-title" class="panel-title">Çakışma kuralı</h2></div>
            <ul class="list-inside list-disc space-y-2 p-4 md:p-5">
                <li>Aynı tesiste aktif iki vardiya çakışamaz.</li>
                <li>Bir vardiyanın bitişi, sonrakinin başlangıcıyla aynı saat olabilir.</li>
                <li>Bitişi başlangıçtan küçük vardiya ertesi gün biter.</li>
            </ul>
        </section>
    </aside>
</div>

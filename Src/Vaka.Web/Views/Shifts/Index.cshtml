@using Vaka.Web.ViewModels.Definitions
@model ShiftListViewModel
@{
    ViewData["Title"] = "Vardiyalar";
    ViewData["Lead"] = "Tesis seçin, vardiyalarını görün. Aktif vardiyalar aynı saatte çakışamaz.";
    ViewData["NavKey"] = "shifts";
    ViewData["StatusMessage"] = Model.StatusMessage;
    var facilityName = Model.Facilities.FirstOrDefault(facility => facility.Id == Model.FacilityId)?.Name ?? "";
}

@section Actions {
    @if (Model.FacilityId > 0)
    {
        <a class="btn btn-primary" href="/shifts/create?facilityId=@Model.FacilityId">
            <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#plus" /></svg>
            Vardiya ekle
        </a>
    }
}

@if (!Model.Facilities.Any())
{
    <partial name="_State" model='("empty", "building-2", "Önce tesis ekleyin", "Vardiyalar tesise bağlıdır. Tesis tanımlandığında vardiyalarını buradan girersiniz.", "Tesis ekle", "/facilities/create")' />
}
else
{
    <form method="get" action="/shifts" class="panel mb-5" aria-label="Tesis seçimi" data-busy-form>
        <div class="grid gap-4 p-4 md:grid-cols-[minmax(0,1fr)_auto] md:items-end md:p-5">
            <div class="field max-w-xl">
                <label class="field-label" for="facilityId">Tesis</label>
                <select id="facilityId" name="facilityId" class="input">
                    @foreach (var facility in Model.Facilities)
                    {
                        <option value="@facility.Id" selected="@(facility.Id == Model.FacilityId)">@facility.Name</option>
                    }
                </select>
            </div>
            <div>
                <button type="submit" class="btn btn-primary">
                    <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#funnel" /></svg>
                    Vardiyaları göster
                </button>
            </div>
        </div>
    </form>

    <partial name="_ListSkeleton" />

    <div data-loading-target>
        @if (!Model.Items.Any())
        {
            <partial name="_State" model='("empty", "clock", "Bu tesiste vardiya yok", "Vardiya saatleri Türkiye saatidir. Bitişi başlangıçtan küçük vardiya ertesi gün biter.", "Vardiya ekle", "/shifts/create?facilityId=" + Model.FacilityId)' />
        }
        else
        {
            <div class="panel">
                <table class="data-table table-stack">
                    <caption class="sr-only">@facilityName vardiyaları, @Model.Items.Length kayıt</caption>
                    <thead>
                        <tr>
                            <th scope="col">Ad</th>
                            <th scope="col">Başlangıç</th>
                            <th scope="col">Bitiş</th>
                            <th scope="col">Durum</th>
                            <th scope="col">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td data-label="Ad" class="max-w-xs break-words font-semibold stack-wide stack-lead">@item.Name</td>
                                <td data-label="Başlangıç"><span class="mono text-base font-bold">@item.StartTime.ToString("HH:mm")</span></td>
                                <td data-label="Bitiş">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <span class="mono text-base font-bold">@item.EndTime.ToString("HH:mm")</span>
                                        @if (item.EndsNextDay)
                                        {
                                            <span class="chip"><svg class="icon h-4 w-4" aria-hidden="true"><use href="/lib/icons/Icons.svg#moon-star" /></svg>Ertesi gün biter</span>
                                        }
                                    </div>
                                </td>
                                <td data-label="Durum"><partial name="_Badge" model='item.IsActive ? "def.active" : "def.inactive"' /></td>
                                <td data-label="İşlem">
                                    <a class="btn btn-secondary" href="/shifts/edit/@item.Id" aria-label="@item.Name vardiyasını düzenle">
                                        <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#pencil" /></svg>
                                        Düzenle
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

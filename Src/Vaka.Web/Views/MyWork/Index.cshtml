@using Vaka.Web.ViewModels.Records
@model MyWorkViewModel
@{
    ViewData["Title"] = "İşlerim";
    ViewData["Lead"] = "Açık kaydınız ve yeni kayıt açma durumunuz.";
    ViewData["NavKey"] = "my-work";
    var active = Model.ActiveRecord;
}

<partial name="_RecordSkeleton" />

<div data-loading-target class="space-y-5">
    @if (Model.OpenBreak is { } openBreak)
    {
        <div class="notice notice-warn" role="status">
            <svg class="icon mt-0.5" aria-hidden="true"><use href="/lib/icons/Icons.svg#coffee" /></svg>
            <div class="min-w-0">
                <p class="font-semibold">Moladasınız</p>
                <p class="mt-0.5 text-sm"><span class="mono whitespace-nowrap">@openBreak.RecordNo</span> kaydında <partial name="_Moment" model='(openBreak.StartedAtLocal, openBreak.StartedAtLocal)' /> saatinde mola başlattınız.</p>
                <a class="btn btn-secondary mt-3" href="/breaks/current" data-busy-link>Mola ekranına git</a>
            </div>
        </div>
    }
    @if (active is null && Model.CanOpenRecord)
    {
        <partial name="_State" model='("empty", "clipboard-list", "Açık işiniz yok", "Temizlik yapacağınız makineyi seçip kayıt açın. Kayıt açılınca makine sizin için tutulur.", "Yeni kayıt aç", "/records/create")' />
    }
    else if (active is null)
    {
        <partial name="_State" model='("empty", "lock", "Şu an kayıt açamazsınız", Model.CannotOpenReason ?? "Kayıt açma şartları sağlanmıyor. Yöneticinize başvurun.", Model.CannotOpenUrl is null ? null : "Kaydı görüntüle", Model.CannotOpenUrl)' />
    }
    else
    {
        <div class="grid items-start gap-5 lg:grid-cols-[minmax(0,1fr)_22rem]">
            <section class="panel min-w-0 border-accent" aria-labelledby="active-title">
                <div class="panel-head">
                    <h2 id="active-title" class="panel-title">Açık iş</h2>
                    <div class="flex flex-wrap items-center gap-2">
                        <partial name="_Badge" model='"CleaningTypeKind." + active.Kind' />
                        <partial name="_Badge" model='"RecordStatus." + active.Status' />
                    </div>
                </div>
                <div class="panel-body space-y-5">
                    <div class="min-w-0">
                        <p class="record-no break-words text-xl md:text-2xl">@active.RecordNo</p>
                        <p class="mt-1 text-lg font-semibold break-words">@active.MachineLabel</p>
                        <p class="text-muted break-words">@active.CleaningTypeName, versiyon @active.VersionNo</p>
                    </div>
                    @if (active.LockExpiresAtLocal is not null)
                    {
                        <div class="notice notice-info">
                            <svg class="icon mt-0.5" aria-hidden="true"><use href="/lib/icons/Icons.svg#lock" /></svg>
                            <div>
                                <p class="font-semibold">Makine <span class="mono">@active.LockExpiresAtLocal.Value.ToString("dd.MM.yyyy HH:mm")</span> saatine kadar sizin için kilitli</p>
                                <p class="mt-0.5 text-sm">İlk adım bu saate kadar başlatılmazsa kayıt Zaman aşımı olur ve makine serbest kalır.</p>
                            </div>
                        </div>
                    }
                    <a class="btn btn-primary btn-lg btn-block" href="@active.Url" data-busy-link>
                        Yürütmeye git
                        <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#chevron-right" /></svg>
                    </a>
                </div>
            </section>

            <aside class="min-w-0 space-y-5" aria-label="Yeni kayıt">
                <section class="panel" aria-labelledby="rule-title">
                    <div class="panel-head"><h2 id="rule-title" class="panel-title">Yeni kayıt</h2></div>
                    <div class="space-y-3 p-4 md:p-5">
                        <p>@(Model.CanOpenRecord ? "Yeni kayıt açabilirsiniz." : Model.CannotOpenReason ?? "Açık kaydınız bitmeden yeni kayıt açılmaz.")</p>
                        @if (Model.CanOpenRecord)
                        {
                            <a class="btn btn-primary btn-block" href="/records/create" data-busy-link>Yeni kayıt aç</a>
                        }
                        else if (Model.CannotOpenUrl is not null && Model.CannotOpenUrl != active.Url)
                        {
                            <a class="btn btn-secondary btn-block" href="@Model.CannotOpenUrl" data-busy-link>Kaydı görüntüle</a>
                        }
                    </div>
                </section>
            </aside>
        </div>
    }

    @if (Model.CanOpenEmergency)
    {
        <section class="panel border-danger" aria-labelledby="emergency-title">
            <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3 p-4 md:p-5">
                <div class="flex min-w-0 items-start gap-3">
                    <svg class="icon icon-lg mt-0.5 text-danger" aria-hidden="true"><use href="/lib/icons/Icons.svg#siren" /></svg>
                    <div class="min-w-0">
                        <h2 id="emergency-title" class="text-lg font-bold">Acil müdahale</h2>
                        <p class="mt-0.5 text-muted">Planlı iş beklemeden kayıt açar ve ilk adımı başlatır. Durum açıklaması zorunludur.</p>
                    </div>
                </div>
                <a class="btn btn-danger btn-lg max-sm:w-full" href="/emergencies/create" data-busy-link>Acil müdahale aç</a>
            </div>
        </section>
    }

    <section aria-labelledby="assigned-title">
        <h2 id="assigned-title" class="mb-3 text-xl font-bold">Görevli olduğum adımlar</h2>
        @if (Model.AssignedSteps.Length == 0)
        {
            <p class="rounded-card border-2 border-dashed border-line-strong p-4 text-muted">Başka bir kayıtta görevli olduğunuz bekleyen adım yok.</p>
        }
        else
        {
            <ul class="grid gap-2 md:grid-cols-2">
                @foreach (var assigned in Model.AssignedSteps)
                {
                    <li class="panel flex min-w-0 flex-col gap-3 p-4 @(assigned.AwaitingMyEntry ? "border-warn" : null)">
                        @if (assigned.AwaitingMyEntry)
                        {
                            <p><span class="badge badge-warn"><svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#hourglass" /></svg><span>Girişiniz bekleniyor</span></span></p>
                        }
                        <div class="min-w-0">
                            <p class="record-no break-words xl:whitespace-nowrap">@assigned.RecordNo</p>
                            <p class="break-words font-semibold">@assigned.MachineLabel</p>
                            <p class="mt-1 break-words">@assigned.StepTitle</p>
                            <p class="break-words text-sm text-muted">Kayıt sahibi: @assigned.OwnerName</p>
                            @if (assigned.AwaitingMyEntry)
                            {
                                <p class="mt-2 text-sm">Kendi PIN'inizle katılınca çalışma süreniz başlar. Girişiniz yapılmadan adım bitmez.</p>
                            }
                        </div>
                        <a class="btn @(assigned.AwaitingMyEntry ? "btn-primary" : "btn-secondary") mt-auto" href="@assigned.Url#step-@assigned.StepId" data-busy-link>
                            @(assigned.AwaitingMyEntry ? "Katılmak için aç" : "Adıma git")
                            <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#chevron-right" /></svg>
                        </a>
                    </li>
                }
            </ul>
        }
    </section>
</div>

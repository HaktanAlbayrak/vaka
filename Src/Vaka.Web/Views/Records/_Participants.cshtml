@using Vaka.Web.Authorization
@using Vaka.Web.Services
@using Vaka.Web.ViewModels.Records
@inject IDurationFormatter DurationFormatter
@inject ISystemSettingsReader Settings
@model (RecordRunViewModel Run, RecordStepViewModel Step)
@{
    var run = Model.Run;
    var step = Model.Step;
    var stepKey = "step-" + step.Id;
    var filtering = run.ParticipantStepId == step.Id;
    var pending = run.PendingParticipant is { } candidate && candidate.StepId == step.Id ? candidate : null;
    var pendingOption = pending is null ? null : run.ParticipantOptions.FirstOrDefault(option => option.UserId == pending.ParticipantUserId);
    var open = filtering || pending is not null;
    var options = filtering ? run.ParticipantOptions : Array.Empty<ParticipantOptionViewModel>();
    var stepStarted = step.Status is StepStatus.InProgress or StepStatus.Completed;
    var sessionUserId = AccountPrincipal.TryGetUserId(User, out var currentUserId) ? currentUserId : (int?)null;
    const string LengthKey = "Vaka.PinLength";
    if (Context.Items[LengthKey] is not int pinLength)
    {
        pinLength = await Settings.GetValueAsync(SettingKeys.PinLength, Context.RequestAborted);
        Context.Items[LengthKey] = pinLength;
    }

    (string Label, string Icon, string Tone) Look(StepParticipantViewModel person) => person.State switch
    {
        ParticipantState.Pending when person.IsOwner && !stepStarted => ("Başlatınca çalışır", "play", "badge-outline"),
        ParticipantState.Pending => ("Girişi bekleniyor", "hourglass", "badge-warn"),
        ParticipantState.Confirmed => ("Katılacak", "user-check", "badge-outline"),
        ParticipantState.Working when step.Status == StepStatus.Completed => ("Çalıştı", "check", "badge-ok"),
        ParticipantState.Working => ("Çalışıyor", "play", "badge-solid"),
        _ => ("Ayrıldı", "arrow-left", "badge-muted"),
    };

    void PinField(string id, string label, string hint)
    {
        <div class="field" data-field data-pin>
            <label class="field-label" for="@id">@label</label>
            <div class="relative">
                <input id="@id" name="Pin" class="input pin-input pr-14" type="password" inputmode="numeric" pattern="[0-9]*"
                       autocomplete="off" spellcheck="false" required maxlength="@pinLength"
                       aria-describedby="@(id)-hint" data-pin-input />
                <button type="button" class="icon-btn field-reveal" data-pin-reveal aria-pressed="false" aria-label="PIN'i göster">
                    <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#eye" /></svg>
                </button>
            </div>
            <p id="@(id)-hint" class="field-hint">@hint</p>
        </div>
    }
}
<div class="space-y-3 max-md:-ml-14">
    @if (step.Participants.Length == 0)
    {
        <p class="text-sm text-muted">Bu adıma görevli eklenmedi. Adım bitince efor yazılmaz.</p>
    }
    else
    {
        <ul class="grid grid-cols-1 gap-3" aria-label="Görevliler">
            @foreach (var person in step.Participants)
            {
                var (stateLabel, stateIcon, stateTone) = Look(person);
                var forSelf = sessionUserId == person.UserId;
                var proxyHint = forSelf ? "Kendi PIN'inizi girin." : $"Bu PIN {person.FullName} adına girilir; {person.FullName} kendisi girsin.";
                var failedHere = run.PendingParticipant is { } failed && failed.StepId == step.Id && failed.ParticipantUserId == person.UserId && !string.IsNullOrEmpty(run.ErrorMessage);
                var quiet = person.State == ParticipantState.Pending && person.IsOwner && !stepStarted;
                <li class="step-person scroll-mt-24" id="@(stepKey)-p@(person.UserId)" data-state="@(quiet ? "Idle" : person.State.ToString())">
                    <p class="step-person-name font-semibold">@person.FullName <span class="mono text-sm font-normal text-muted">@person.RegistryNo</span>@(person.IsOwner ? ", sahip" : "")</p>
                    <p>
                        <span class="badge @stateTone"><svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#@stateIcon" /></svg><span>@stateLabel</span></span>
                    </p>
                    <p class="flex flex-wrap gap-x-3 gap-y-0.5 text-sm text-muted">
                        @switch (person.State)
                        {
                            case ParticipantState.Pending when person.IsOwner && !stepStarted:
                                <span>Adım başlayınca girişsiz çalışmaya başlar.</span>
                                break;
                            case ParticipantState.Pending when step.Status == StepStatus.InProgress:
                                <span>Kendi PIN'iyle katılınca çalışma süresi başlar.</span>
                                break;
                            case ParticipantState.Pending:
                                <span>Adım başlamadan ya da başladıktan sonra kendi PIN'iyle katılır.</span>
                                break;
                            case ParticipantState.Confirmed:
                                if (person.JoinedAtLocal is { } confirmedAt)
                                {
                                    <span>Onayladı <partial name="_Moment" model='(confirmedAt, run.OpenedAtLocal)' /></span>
                                }
                                <span>Adım başlayınca çalışır.</span>
                                break;
                            default:
                                if (person.JoinedAtLocal is { } joinedAt)
                                {
                                    <span>Katıldı <partial name="_Moment" model='(joinedAt, run.OpenedAtLocal)' /></span>
                                }
                                if (person.LeftAtLocal is { } leftAt)
                                {
                                    <span>Ayrıldı <partial name="_Moment" model='(leftAt, run.OpenedAtLocal)' /></span>
                                }
                                if (person.WorkSeconds is { } workSeconds)
                                {
                                    <span>Çalışma <partial name="_Duration" model="DurationFormatter.Format(workSeconds)" /></span>
                                }
                                break;
                        }
                    </p>

                    @if (!person.CanJoin && !person.CanLeave && !string.IsNullOrEmpty(person.BlockedReason))
                    {
                        <p class="flex items-start gap-2 text-sm font-semibold">
                            <svg class="icon mt-0.5 h-4 w-4" aria-hidden="true"><use href="/lib/icons/Icons.svg#info" /></svg>
                            <span class="min-w-0 break-words">@person.BlockedReason</span>
                        </p>
                    }

                    @if (failedHere)
                    {
                        <div class="notice notice-danger scroll-mt-24" role="alert" tabindex="-1" data-form-summary data-focus-first>
                            <svg class="icon mt-0.5" aria-hidden="true"><use href="/lib/icons/Icons.svg#circle-alert" /></svg>
                            <div class="min-w-0">
                                <p class="font-semibold">İşlem yapılmadı</p>
                                <p class="mt-0.5 break-words text-sm">@run.ErrorMessage</p>
                            </div>
                        </div>
                    }

                    @if (person.CanJoin)
                    {
                        <details class="tool" open="@failedHere">
                            <summary aria-label="Adıma katıl: @person.FullName">
                                <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#user-check" /></svg>
                                Adıma katıl
                            </summary>
                            <form method="post" action="/records/join-step/@step.Id#@(stepKey)-p@(person.UserId)" class="tool-body space-y-3" data-validate data-command-form asp-antiforgery="true">
                                <input type="hidden" name="CommandId" value="@run.CommandId" />
                                <input type="hidden" name="ParticipantUserId" value="@person.UserId" />
                                <p class="break-words text-sm">@person.FullName adıma katılır. Katılma anı sunucu saatiyle yazılır.</p>
                                @{ PinField("pin-join-" + step.Id + "-" + person.UserId, person.FullName + " PIN'i", proxyHint); }
                                <div class="notice notice-danger" role="alert" data-command-status hidden>
                                    <svg class="icon mt-0.5" aria-hidden="true"><use href="/lib/icons/Icons.svg#wifi-off" /></svg>
                                    <p class="font-semibold" data-command-message></p>
                                </div>
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#user-check" /></svg>
                                    Adıma katıl
                                </button>
                            </form>
                        </details>
                    }
                    @if (person.CanLeave)
                    {
                        <details class="tool" open="@failedHere">
                            <summary aria-label="Adımdan ayrıl: @person.FullName">
                                <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#arrow-left" /></svg>
                                Adımdan ayrıl
                            </summary>
                            <form method="post" action="/records/leave-step/@step.Id#@(stepKey)-p@(person.UserId)" class="tool-body space-y-3" data-validate data-command-form asp-antiforgery="true">
                                <input type="hidden" name="CommandId" value="@run.CommandId" />
                                <input type="hidden" name="ParticipantUserId" value="@person.UserId" />
                                <p class="break-words text-sm">@person.FullName adımdan ayrılır. Aynı adıma yeniden katılamaz.</p>
                                @{ PinField("pin-leave-" + step.Id + "-" + person.UserId, person.FullName + " PIN'i", proxyHint); }
                                <div class="notice notice-danger" role="alert" data-command-status hidden>
                                    <svg class="icon mt-0.5" aria-hidden="true"><use href="/lib/icons/Icons.svg#wifi-off" /></svg>
                                    <p class="font-semibold" data-command-message></p>
                                </div>
                                <button type="submit" class="btn btn-secondary btn-lg">
                                    <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#arrow-left" /></svg>
                                    Adımdan ayrıl
                                </button>
                            </form>
                        </details>
                    }
                    @if (person.CanRemove)
                    {
                        <details class="tool tool-danger" open="@failedHere">
                            <summary aria-label="@person.FullName görevlisini bu adımdan çıkarmak için aç">
                                <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#user-x" /></svg>
                                Listeden çıkar
                            </summary>
                            <form method="post" action="/records/remove-participant/@step.Id#@(stepKey)-p@(person.UserId)" class="tool-body space-y-3" data-validate data-command-form asp-antiforgery="true">
                                <input type="hidden" name="CommandId" value="@run.CommandId" />
                                <input type="hidden" name="ParticipantUserId" value="@person.UserId" />
                                <p class="break-words text-sm">@person.FullName henüz katılmadı, listeden çıkarılır. Onay için kendi PIN'inizi girin.</p>
                                <partial name="_PinInput" model='("pin-remove-person-" + step.Id + "-" + person.UserId, "PIN", "verify", (int?)null, "Pin", (string?)null)' />
                                <div class="notice notice-danger" role="alert" data-command-status hidden>
                                    <svg class="icon mt-0.5" aria-hidden="true"><use href="/lib/icons/Icons.svg#wifi-off" /></svg>
                                    <p class="font-semibold" data-command-message></p>
                                </div>
                                <button type="submit" class="btn btn-danger btn-lg">
                                    <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#user-x" /></svg>
                                    Görevliyi çıkar
                                </button>
                            </form>
                        </details>
                    }
                </li>
            }
        </ul>
    }

    @if (step.CanManageParticipants)
    {
        <details class="tool" open="@open">
            <summary>
                <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#users" /></svg>
                Görevleri düzenle
            </summary>
            <div class="tool-body space-y-5">
                <form method="get" action="/records/run/@run.Id" class="field" data-people-nojs>
                    <input type="hidden" name="stepId" value="@step.Id" />
                    <label class="field-label" for="@(stepKey)-people">Kişi ara</label>
                    <div class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start">
                        <input id="@(stepKey)-people" name="people" type="search" class="input" value="@(filtering ? run.ParticipantQuery : null)" autocomplete="off" spellcheck="false" inputmode="search" />
                        <button type="submit" class="btn btn-secondary min-h-12">
                            <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#search" /></svg>
                            Kişileri ara
                        </button>
                    </div>
                </form>

                <form method="post" action="/records/add-participant/@step.Id" class="space-y-4" data-validate data-command-form asp-antiforgery="true">
                    <input type="hidden" name="CommandId" value="@run.CommandId" />
                    <div class="space-y-3" data-people-picker data-people-url="/records/people" data-step-id="@step.Id">
                        <div class="field" data-field data-people-js>
                            <label class="field-label" for="@(stepKey)-search">Görevli ekle</label>
                            <input id="@(stepKey)-search" type="text" role="combobox" class="input" autocomplete="off" spellcheck="false" inputmode="search" enterkeyhint="search"
                                   data-choice-for="[data-people-input]" data-required-message="Bir kişi seçin." aria-autocomplete="list" aria-expanded="false" aria-controls="@(stepKey)-results" aria-describedby="@(stepKey)-hint @(stepKey)-status" data-people-search />
                            <ul id="@(stepKey)-results" role="listbox" tabindex="-1" class="lot-results" aria-label="Bulunan kişiler" data-people-results hidden></ul>
                            <div class="space-y-2" aria-hidden="true" data-people-loading hidden>
                                <div class="skeleton h-14 w-full"></div>
                                <div class="skeleton h-14 w-full"></div>
                            </div>
                            <p id="@(stepKey)-hint" class="field-hint">Ad ya da sicil no parçası yazın, listeden operatörü seçin.@(step.Status == StepStatus.InProgress ? " Eklenen kişi kendi PIN'iyle katılınca çalışmaya başlar." : "")</p>
                            <p id="@(stepKey)-status" class="field-hint" role="status" data-people-status></p>
                        </div>
                        <div class="space-y-2" data-people-js>
                            <div data-people-chosen hidden>
                                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                                    <p class="min-w-0 break-words text-base"><span class="font-semibold">Seçilen kişi:</span> <span data-people-chosen-name></span></p>
                                    <button type="button" class="btn btn-secondary min-h-11" data-people-change>
                                        <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#pencil" /></svg>
                                        Değiştir
                                    </button>
                                </div>
                            </div>
                            <div class="notice notice-warn" data-people-warning hidden>
                                <svg class="icon mt-0.5" aria-hidden="true"><use href="/lib/icons/Icons.svg#triangle-alert" /></svg>
                                <p class="text-sm">Bu kişinin kendi açık kaydı var. Yine de ekleyebilirsiniz.</p>
                            </div>
                            <input type="hidden" name="ParticipantUserId" disabled data-people-input />
                        </div>
                        @if (pending is not null)
                        {
                            <template data-people-pending data-user-id="@pending.ParticipantUserId" data-full-name="@(pendingOption?.FullName ?? "Önceden seçilen kişi")"
                                      data-registry-no="@(pendingOption?.RegistryNo ?? "-")" data-warn="@(pendingOption?.HasOwnActiveRecord == true ? "true" : "false")"></template>
                        }

                        <fieldset class="space-y-2" data-people-nojs>
                            <legend class="field-label">Görevli seç</legend>
                            @if (!filtering)
                            {
                                <p class="text-sm text-muted">Önce kişi arayın.</p>
                            }
                            else if (options.Length == 0)
                            {
                                <p class="text-sm text-muted">Aramaya uyan aktif operatör yok.</p>
                            }
                            else
                            {
                                @foreach (var option in options)
                                {
                                    <label class="choice @(option.IsAvailable ? null : "opacity-70")">
                                        <input type="radio" name="ParticipantUserId" value="@option.UserId" checked="@(pending?.ParticipantUserId == option.UserId)" disabled="@(!option.IsAvailable)" />
                                        <span class="min-w-0">
                                            <span class="block break-words font-semibold">@option.FullName <span class="mono text-sm text-muted">@option.RegistryNo</span></span>
                                            @if (!option.IsAvailable)
                                            {
                                                <span class="block text-sm text-muted">Eklenemez: @option.UnavailableReason</span>
                                            }
                                            else if (option.HasOwnActiveRecord)
                                            {
                                                <span class="block text-sm font-semibold text-warn">Kendi açık kaydı var, yine de eklenebilir.</span>
                                            }
                                        </span>
                                    </label>
                                }
                                @if (run.ParticipantOptionsTruncated)
                                {
                                    <p class="text-sm text-muted">Liste kısaltıldı. Aramayı daraltın.</p>
                                }
                            }
                        </fieldset>
                    </div>
                    <partial name="_PinInput" model='("pin-add-person-" + step.Id, "PIN", "verify", (int?)null, "Pin", (string?)null)' />
                    <div class="notice notice-danger" role="alert" data-command-status hidden>
                        <svg class="icon mt-0.5" aria-hidden="true"><use href="/lib/icons/Icons.svg#wifi-off" /></svg>
                        <p class="font-semibold" data-command-message></p>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg">
                        <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#user-plus" /></svg>
                        Görevliyi ekle
                    </button>
                </form>
            </div>
        </details>
    }
</div>

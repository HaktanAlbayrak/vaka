@using Vaka.Web.ViewModels.Records
@model RecordCreateViewModel
@{
    ViewData["Title"] = "Yeni kayıt";
    ViewData["Lead"] = "Makineyi ve temizlik tipini seçin, PIN'inizle kaydı açın.";
    ViewData["NavKey"] = "new-record";

    string? ErrorOf(string key) =>
        ViewData.ModelState.TryGetValue(key, out var entry) && entry.Errors.Count > 0 ? entry.Errors[0].ErrorMessage : null;

    string TypeMeta(CleaningTypeOptionViewModel type) =>
        "Versiyon " + type.VersionNo + " · Makine " + type.DefaultLockMinutes + " dk tutulur · " + (type.MaterialRequired ? "Malzeme gerekli" : "Malzeme gerekmez");

    var facilityError = ErrorOf("FacilityId");
    var lineError = ErrorOf("LineId");
    var machineError = ErrorOf("MachineId");
    var typeError = ErrorOf("CleaningTypeId");
    var workOrderError = ErrorOf("WorkOrderNo");
    var lockError = ErrorOf("LockMinutes");
    var selectedType = Model.CleaningTypes.FirstOrDefault(type => type.Id == Model.CleaningTypeId);
    var lockValue = Model.LockMinutes > 0 ? (int?)Model.LockMinutes : Model.DefaultLockMinutes;
    var busyMachines = Model.Machines.Where(machine => !machine.IsAvailable).ToList();
    var materialText = selectedType is null ? "none" : selectedType.MaterialRequired ? "required" : "optional";
}

<partial name="_FormSummary" model='"Kayıt açılamadı"' />

<div class="grid items-start gap-5 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <form method="post" class="panel min-w-0" action="/records/create" data-validate data-command-form data-unsaved-guard aria-labelledby="create-title" asp-antiforgery="true">
        <div class="panel-head">
            <h2 id="create-title" class="panel-title">Kayıt bilgileri</h2>
        </div>
        <div class="panel-body space-y-6">
            <input type="hidden" name="CommandId" value="@Model.CommandId" />

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="notice notice-danger" role="alert" tabindex="-1" data-form-summary>
                    <svg class="icon mt-0.5" aria-hidden="true"><use href="/lib/icons/Icons.svg#lock" /></svg>
                    <div class="min-w-0">
                        <p class="font-semibold">Kayıt açılamadı</p>
                        <p class="mt-0.5 text-sm">@Model.ErrorMessage</p>
                        @if (!string.IsNullOrEmpty(Model.ErrorUrl))
                        {
                            <a class="mt-1 inline-flex min-h-11 items-center font-semibold underline underline-offset-2" href="@Model.ErrorUrl">Kaydı görüntüle</a>
                        }
                    </div>
                </div>
            }

            <div class="space-y-5">
                <h3 class="text-lg font-bold">Makine</h3>
                <div class="field" data-field>
                    <label class="field-label" for="FacilityId">Tesis</label>
                    <div class="select-wrap">
                        <select id="FacilityId" name="FacilityId" class="input" required data-required-message="Tesis seçin."
                            data-cascade-url="/records/lines" data-cascade-target="LineId" data-cascade-status="line-status"
                            data-cascade-noun="Hatlar" data-cascade-none="Bu tesiste hat yok."
                            aria-describedby="@(facilityError is null ? null : "FacilityId-error")" aria-invalid="@(facilityError is null ? null : "true")">
                        <option value="">Tesis seçin</option>
                        @foreach (var facility in Model.Facilities)
                        {
                            <option value="@facility.Id" selected="@(facility.Id == Model.FacilityId)">@facility.Label</option>
                        }
                    </select>
                        <svg class="icon select-arrow" aria-hidden="true"><use href="/lib/icons/Icons.svg#chevron-down" /></svg>
                    </div>
                    @if (facilityError is not null)
                    {
                        <partial name="_FieldError" model='("FacilityId-error", facilityError)' />
                    }
                </div>

                <div class="field" data-field>
                    <label class="field-label" for="LineId">Hat</label>
                    <div class="select-wrap">
                        <select id="LineId" name="LineId" class="input" required data-required-message="Hat seçin."
                            data-cascade-url="/records/machines" data-cascade-param="lineId" data-cascade-target="MachineId" data-cascade-status="machine-status"
                            data-cascade-noun="Makineler" data-cascade-none="Bu hatta makine yok."
                            aria-describedby="@(lineError is null ? "line-status" : "line-status LineId-error")" aria-invalid="@(lineError is null ? null : "true")">
                        <option value="">Hat seçin</option>
                        @foreach (var line in Model.Lines)
                        {
                            <option value="@line.Id" selected="@(line.Id == Model.LineId)">@line.Label</option>
                        }
                    </select>
                        <svg class="icon select-arrow" aria-hidden="true"><use href="/lib/icons/Icons.svg#chevron-down" /></svg>
                    </div>
                    <p id="line-status" class="field-hint" role="status"></p>
                    @if (lineError is not null)
                    {
                        <partial name="_FieldError" model='("LineId-error", lineError)' />
                    }
                </div>

                <div class="field" data-field>
                    <label class="field-label" for="MachineId">Makine</label>
                    <div class="select-wrap">
                        <select id="MachineId" name="MachineId" class="input" required data-required-message="Makine seçin."
                            data-cascade-busy="machine-busy" data-cascade-busy-box="machine-busy-box"
                            aria-describedby="@(machineError is null ? "machine-status" : "machine-status MachineId-error")" aria-invalid="@(machineError is null ? null : "true")">
                        <option value="">Makine seçin</option>
                        @foreach (var machine in Model.Machines)
                        {
                            <option value="@machine.Id" disabled="@(!machine.IsAvailable)" selected="@(machine.Id == Model.MachineId)">@(machine.IsAvailable ? machine.Label : machine.Label + " - " + machine.BusyReason)</option>
                        }
                    </select>
                        <svg class="icon select-arrow" aria-hidden="true"><use href="/lib/icons/Icons.svg#chevron-down" /></svg>
                    </div>
                    <p id="machine-status" class="field-hint" role="status"></p>
                    @if (machineError is not null)
                    {
                        <partial name="_FieldError" model='("MachineId-error", machineError)' />
                    }
                    <div id="machine-busy-box" class="notice notice-info" hidden="@(busyMachines.Count == 0)">
                        <svg class="icon mt-0.5" aria-hidden="true"><use href="/lib/icons/Icons.svg#lock" /></svg>
                        <div class="min-w-0">
                            <p class="font-semibold">Şu an seçilemeyen makineler</p>
                            <ul id="machine-busy" class="mt-1 space-y-1 text-sm">
                                @foreach (var machine in busyMachines)
                                {
                                    <li class="break-words"><span class="font-semibold">@machine.Label:</span> @machine.BusyReason</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>

                <div data-cascade-fallback>
                    <button type="submit" class="btn btn-secondary" name="refresh" value="true" formnovalidate>
                        <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#refresh-cw" /></svg>
                        Seçimi uygula
                    </button>
                    <p class="field-hint mt-1.5">Tesis, hat ya da makineyi değiştirince bu düğmeyle listeleri yenileyin.</p>
                </div>
            </div>

            <fieldset class="field space-y-3 border-t-2 border-line pt-6" data-field data-type-picker data-type-url="/records/cleaning-types" data-machine-select="MachineId"
                      data-lock-input="LockMinutes" data-material-note="material-note"
                      aria-describedby="@(typeError is null ? "type-status" : "type-status CleaningTypeId-error")">
                <legend class="text-lg font-bold">Temizlik tipi</legend>
                <p id="type-status" class="field-hint" role="status" data-type-status>@(Model.MachineId is null ? "Önce makineyi seçin." : Model.CleaningTypes.Length == 0 ? "Bu makineye eşli, yürürlükte versiyonu olan planlı tip yok." : "")</p>
                <div class="grid gap-2" data-type-list>
                    @foreach (var type in Model.CleaningTypes)
                    {
                        <partial name="_TypeChoice" model='(type.Id == Model.CleaningTypes[0].Id ? "CleaningTypeId" : "CleaningTypeId-" + type.Id, type.Id.ToString(), type.Name, TypeMeta(type), type.MaterialRequired ? "true" : "false", type.DefaultLockMinutes.ToString(), type.Id == Model.CleaningTypeId)' />
                    }
                </div>
                @if (typeError is not null)
                {
                    <partial name="_FieldError" model='("CleaningTypeId-error", typeError)' />
                }
                <template data-type-template>
                    <partial name="_TypeChoice" model='("", "", "", "", "false", "", false)' />
                </template>
            </fieldset>

            <div class="space-y-5 border-t-2 border-line pt-6">
                <h3 class="text-lg font-bold">İş bilgisi</h3>
                <partial name="_Field" model='("WorkOrderNo", "İş emri no (isteğe bağlı)", Model.WorkOrderNo, "text", "off", "Dış sistemden bir iş emri numaranız varsa yazın. Boş bırakırsanız kayıt açılınca sistem numara atar.", false, false)' />
                <div class="field" data-field>
                    <label class="field-label" for="Note">Açıklama</label>
                    <textarea id="Note" name="Note" class="input" rows="3" autocomplete="off">@Model.Note</textarea>
                    <p class="field-hint">İsteğe bağlı. Kayıtla birlikte yürütme ekranında görünür.</p>
                </div>
                <div class="field max-w-xs" data-field>
                    <label class="field-label" for="LockMinutes">Makine kilit süresi (dk)</label>
                    <input id="LockMinutes" name="LockMinutes" class="input mono" type="number" inputmode="numeric" autocomplete="off" min="1" max="@Model.MaxLockMinutes" step="1" value="@lockValue" required
                           data-required-message="Kilit süresini girin." aria-describedby="@(lockError is null ? "lock-hint" : "lock-hint LockMinutes-error")" aria-invalid="@(lockError is null ? null : "true")" />
                    <p id="lock-hint" class="field-hint">En çok <span class="mono font-bold">@Model.MaxLockMinutes</span> dk. İlk adım bu süre içinde başlamazsa kayıt Zaman aşımı olur.<span data-lock-default-note>@(Model.DefaultLockMinutes is null ? "" : " Tip varsayılanı " + Model.DefaultLockMinutes + " dk.")</span></p>
                    @if (lockError is not null)
                    {
                        <partial name="_FieldError" model='("LockMinutes-error", lockError)' />
                    }
                </div>
            </div>

            <div class="space-y-3 border-t-2 border-line pt-6">
                <h3 class="text-lg font-bold">Malzeme</h3>
                <p id="material-note" class="text-base" data-text-required="Seçilen tip malzeme gerektiriyor. En az bir lot ekleyin." data-text-optional="Seçilen tip malzeme gerektirmiyor. İsterseniz lot ekleyebilirsiniz." data-text-none="Önce temizlik tipini seçin.">@(materialText == "required" ? "Seçilen tip malzeme gerektiriyor. En az bir lot ekleyin." : materialText == "optional" ? "Seçilen tip malzeme gerektirmiyor. İsterseniz lot ekleyebilirsiniz." : "Önce temizlik tipini seçin.")</p>
                <partial name="_LotPicker" model='("lots", "multi", "Materials[{i}].MaterialLotId", "Materials[{i}].ExpiredReason", false, Model.Materials, "Malzeme adı, kodu ya da lot no yazın. Son kullanma tarihi geçmiş lot gerekçeyle eklenir.")' />
                <partial name="_LotFallback" model='("multi", Model.LotQuery, Model.AvailableLots, Model.AvailableLotsTruncated, (int?)null, (string?)null)' />
            </div>

            <div class="space-y-3 border-t-2 border-line pt-6">
                <h3 class="text-lg font-bold">Onay</h3>
                <div class="max-w-xs">
                    <partial name="_PinInput" model='("pin-new", "PIN", "verify", (int?)null, "Pin", (string?)null)' />
                </div>
            </div>

            <div class="space-y-3 border-t-2 border-line pt-5">
                <div class="notice notice-danger" role="alert" data-command-status hidden>
                    <svg class="icon mt-0.5" aria-hidden="true"><use href="/lib/icons/Icons.svg#wifi-off" /></svg>
                    <p class="font-semibold" data-command-message></p>
                </div>
                <div class="flex flex-wrap items-center gap-3">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#file-plus" /></svg>
                        Kaydı oluştur
                    </button>
                    <a class="btn btn-secondary btn-lg" href="/my-work">Vazgeç</a>
                </div>
            </div>
        </div>
    </form>

    <aside class="min-w-0 space-y-5" aria-label="Kayıt açılınca">
        <section class="panel" aria-labelledby="after-title">
            <div class="panel-head"><h2 id="after-title" class="panel-title">Kayıt açılınca</h2></div>
            <ol class="list-inside list-decimal space-y-3 p-4 md:p-5">
                <li>Sistem kayıt numarasını verir ve yürütme ekranını açar.</li>
                <li>Makine seçtiğiniz süre kadar sizin için tutulur.</li>
                <li>Kilit bitmeden ilk adımı başlatın, yoksa kayıt Zaman aşımı olur.</li>
            </ol>
        </section>
        <section class="panel" aria-labelledby="rule-title">
            <div class="panel-head"><h2 id="rule-title" class="panel-title">Tek açık iş</h2></div>
            <p class="p-4 md:p-5">Aynı anda yalnız bir açık kaydınız olabilir. Başka bir kaydınız Açıldı ya da Devam ediyor durumundaysa yeni kayıt açılmaz.</p>
        </section>
    </aside>
</div>

@model string
@{
    var general = new List<string>();
    var fields = new List<(string Id, string Message)>();
    foreach (var (key, entry) in ViewData.ModelState)
    {
        if (entry.Errors.Count == 0)
        {
            continue;
        }
        if (string.IsNullOrEmpty(key))
        {
            general.AddRange(entry.Errors.Select(error => error.ErrorMessage));
        }
        else
        {
            fields.Add((key.Replace('.', '-'), entry.Errors[0].ErrorMessage));
        }
    }
}
@if (general.Count > 0 || fields.Count > 0)
{
    <div class="notice notice-danger mb-5" role="alert" tabindex="-1" data-form-summary>
        <svg class="icon mt-0.5" aria-hidden="true"><use href="/lib/icons/Icons.svg#circle-alert" /></svg>
        <div class="min-w-0">
            <p class="font-semibold">@Model</p>
            @foreach (var message in general)
            {
                <p class="mt-1 text-sm">@message</p>
            }
            @if (fields.Count > 0)
            {
                <ul class="mt-1 text-sm">
                    @foreach (var field in fields)
                    {
                        <li><a class="inline-flex min-h-11 items-center break-words underline underline-offset-2" href="#@field.Id">@field.Message</a></li>
                    }
                </ul>
            }
        </div>
    </div>
}

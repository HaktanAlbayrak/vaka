@model (DateTime Value, DateTime Reference)
<time class="mono" datetime="@Model.Value.ToString("yyyy-MM-dd'T'HH:mm")">@if (Model.Value.Date == Model.Reference.Date){<span class="whitespace-nowrap">@Model.Value.ToString("HH:mm")</span>}else{<span class="whitespace-nowrap">@Model.Value.ToString("dd.MM.yyyy")</span><text> </text><span class="whitespace-nowrap">@Model.Value.ToString("HH:mm")</span>}</time>

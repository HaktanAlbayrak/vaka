@model string
@functions {
    private static readonly Dictionary<string, (string Label, string Icon, string Tone)> Vocabulary = new()
    {
        ["record.open"] = ("Açıldı", "lock", "badge-outline"),
        ["record.running"] = ("Devam ediyor", "play", "badge-solid"),
        ["record.held"] = ("Beklemede", "pause", "badge-warn"),
        ["record.done"] = ("Tamamlandı", "check", "badge-ok"),
        ["record.expired"] = ("Zaman aşımı", "timer-off", "badge-muted"),
        ["record.cancelled"] = ("İptal edildi", "ban", "badge-danger"),
        ["record.aborted"] = ("Yarıda kapatıldı", "octagon-x", "badge-danger"),

        ["phase.waiting"] = ("Bekliyor", "circle-dashed", "badge-dashed"),
        ["phase.running"] = ("Devam ediyor", "play", "badge-solid"),
        ["phase.done"] = ("Tamamlandı", "check", "badge-ok"),
        ["phase.short"] = ("Tamamlandı - süre altında", "triangle-alert", "badge-warn"),
        ["phase.cut"] = ("Kesildi", "circle-slash", "badge-danger"),

        ["step.waiting"] = ("Bekliyor", "lock", "badge-dashed"),
        ["step.ready"] = ("Hazır", "circle-arrow-right", "badge-outline"),
        ["step.running"] = ("Devam ediyor", "play", "badge-solid"),
        ["step.done"] = ("Tamamlandı", "check", "badge-ok"),
        ["step.cut"] = ("Kesildi", "circle-slash", "badge-danger"),

        ["break.open"] = ("Mola açık", "coffee", "badge-warn"),
        ["break.closed"] = ("Mola kapandı", "check", "badge-muted"),

        ["request.pending"] = ("Bekliyor", "hourglass", "badge-warn"),
        ["request.approved"] = ("Onaylandı", "check", "badge-ok"),
        ["request.rejected"] = ("Reddedildi", "circle-x", "badge-danger"),
        ["request.withdrawn"] = ("Geri çekildi", "undo-2", "badge-muted"),
        ["request.invalid"] = ("Geçersiz", "circle-slash", "badge-muted"),

        ["kind.planned"] = ("Planlı", "clipboard-list", "badge-muted"),
        ["kind.emergency"] = ("Acil", "triangle-alert", "badge-danger"),
        ["lot.expired"] = ("SKT geçmiş", "timer-off", "badge-danger"),

        ["def.active"] = ("Aktif", "check", "badge-ok"),
        ["def.inactive"] = ("Pasif", "ban", "badge-muted"),
        ["machine.retired"] = ("Kullanımdan kaldırıldı", "power-off", "badge-danger"),

        ["user.active"] = ("Etkin", "check", "badge-ok"),
        ["user.inactive"] = ("Pasif", "ban", "badge-muted"),
        ["user.pinlocked"] = ("PIN kilitli", "lock", "badge-danger"),
        ["user.firstlogin"] = ("İlk giriş bekliyor", "hourglass", "badge-warn"),

        ["machine.free"] = ("Boş", "circle-check", "badge-ok"),

        ["integrity.ok"] = ("Doğrulandı", "shield-check", "badge-ok"),
        ["integrity.broken"] = ("Bütünlük ihlali", "shield-alert", "badge-danger"),
        ["integrity.event.ok"] = ("Geçerli", "check", "badge-ok"),
        ["integrity.event.bad"] = ("Sorunlu", "octagon-x", "badge-danger"),
    };

    // Enum üye adından sözlük anahtarına tek eşleme. Görünümler enum adını verir, rozet biçimi yalnız burada belirlenir.
    private static readonly Dictionary<string, string> EnumKeys = new()
    {
        ["RecordStatus.Opened"] = "record.open",
        ["RecordStatus.InProgress"] = "record.running",
        ["RecordStatus.OnHold"] = "record.held",
        ["RecordStatus.Completed"] = "record.done",
        ["RecordStatus.TimedOut"] = "record.expired",
        ["RecordStatus.Cancelled"] = "record.cancelled",
        ["RecordStatus.Aborted"] = "record.aborted",

        ["PhaseStatus.Waiting"] = "phase.waiting",
        ["PhaseStatus.InProgress"] = "phase.running",
        ["PhaseStatus.Completed"] = "phase.done",
        ["PhaseStatus.CompletedBelowMinimum"] = "phase.short",
        ["PhaseStatus.Interrupted"] = "phase.cut",

        ["StepStatus.Waiting"] = "step.waiting",
        ["StepStatus.Ready"] = "step.ready",
        ["StepStatus.InProgress"] = "step.running",
        ["StepStatus.Completed"] = "step.done",
        ["StepStatus.Interrupted"] = "step.cut",

        ["MachineState.Free"] = "machine.free",
        ["MachineState.Opened"] = "record.open",
        ["MachineState.InProgress"] = "record.running",
        ["MachineState.OnHold"] = "record.held",

        ["CleaningTypeKind.Planned"] = "kind.planned",
        ["CleaningTypeKind.Emergency"] = "kind.emergency",
    };
}
@{
    // "grup|Görünen ad" biçimi (ör. "record|Tamamlandı"): ViewModel yalnız etiket verdiğinde grup içindeki karşılığı bulunur.
    var key = Model;
    var split = Model.IndexOf('|');
    if (split > 0)
    {
        var group = Model[..split] + ".";
        var label = Model[(split + 1)..];
        key = Vocabulary.Where(item => item.Key.StartsWith(group, StringComparison.Ordinal) && item.Value.Label == label).Select(item => item.Key).FirstOrDefault() ?? Model;
    }
    var badge = Vocabulary.TryGetValue(key, out var found) ? found : Vocabulary.TryGetValue(EnumKeys.GetValueOrDefault(key, key), out var viaEnum) ? viaEnum : (Label: split > 0 ? Model[(split + 1)..] : Model, Icon: "circle-dashed", Tone: "badge-muted");
}
<span class="badge @badge.Tone"><svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#@badge.Icon" /></svg><span>@badge.Label</span></span>

@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isFocus = isAuthenticated && ViewData["Focus"] is true;
    var showRail = isAuthenticated && !isFocus;
    var showPerson = isAuthenticated;

    var personName = "";
    var registryNo = "";
    var roleLabel = "";
    if (isAuthenticated)
    {
        personName = User.Identity!.Name ?? "";
        registryNo = User.FindFirst(VakaClaimTypes.RegistryNo)?.Value ?? "";
        roleLabel = string.Join(", ", new[] { Roles.Operator, Roles.Manager, Roles.Auditor, Roles.SuperAdmin }.Where(User.IsInRole).Select(Roles.Label));
    }
    var initials = string.Concat(personName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0]));

    var navItems = new List<(string Group, string Label, string Icon, string? Href, string Key)>();
    if (showRail)
    {
        if (User.IsInRole(Roles.Operator))
        {
            navItems.Add(("", "İşlerim", "layout-list", "/my-work", "my-work"));
            navItems.Add(("", "Yeni kayıt", "file-plus", "/records/create", "new-record"));
        }
        else if (User.IsInRole(Roles.Manager) || User.IsInRole(Roles.Auditor))
        {
            navItems.Add(("", "Ana sayfa", "house", "/dashboard", "home"));
        }
        var isReader = User.IsInRole(Roles.Operator) || User.IsInRole(Roles.Manager) || User.IsInRole(Roles.Auditor);
        var multiRole = User.IsInRole(Roles.Operator) && (User.IsInRole(Roles.Manager) || User.IsInRole(Roles.Auditor));
        var readerGroup = User.IsInRole(Roles.Operator) && !multiRole ? "" : "İzleme";
        if (multiRole)
        {
            navItems.Add((readerGroup, "Pano", "layout-dashboard", "/dashboard", "home"));
        }
        if (isReader)
        {
            if (!User.IsInRole(Roles.Operator))
            {
                navItems.Add((readerGroup, "Kayıtlar", "list-checks", "/records", "records"));
            }
            navItems.Add((readerGroup, "Makine panosu", "factory", "/machine-board", "machine-board"));
            if (User.IsInRole(Roles.Operator))
            {
                navItems.Add((readerGroup, "Kayıtlar", "list-checks", "/records", "records"));
            }
        }
        if (User.IsInRole(Roles.Manager) || User.IsInRole(Roles.Auditor))
        {
            navItems.Add(("Raporlar", "Süre ve efor", "chart-column", "/reports/durations", "report-durations"));
            navItems.Add(("Raporlar", "Makine raporu", "factory", "/reports/machine", "report-machine"));
            navItems.Add(("Raporlar", "Malzeme izlenebilirliği", "route", "/reports/materials", "report-materials"));
        }
        if (User.IsInRole(Roles.Manager))
        {
            navItems.Add(("Tanımlar", "Tesisler", "building-2", "/facilities", "facilities"));
            navItems.Add(("Tanımlar", "Makineler", "cog", "/machines", "machines"));
            navItems.Add(("Tanımlar", "Vardiyalar", "clock", "/shifts", "shifts"));
            navItems.Add(("Tanımlar", "Malzemeler", "package", "/materials", "materials"));
            navItems.Add(("Tanımlar", "Temizlik tipleri", "clipboard-list", "/cleaning-types", "cleaning-types"));
        }
        if (User.IsInRole(Roles.Manager) || User.IsInRole(Roles.SuperAdmin))
        {
            navItems.Add(("Yönetim", "Kullanıcılar", "users", "/users", "users"));
        }
        navItems.Add(("Hesap", "Parola ve PIN", "key-round", "/account/security", "security"));
    }

    var bottomItems = navItems.Where(item => item.Href is not null && !(item.Key == "home" && item.Label == "Pano")).Take(3).ToList();
    var currentKey = ViewData["NavKey"] as string ?? "";
    var homeHref = "/";
    var statusMessage = ViewData["StatusMessage"] as string;
}
<!DOCTYPE html>
<html lang="tr" data-online="true">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - Vaka</title>
    <partial name="_Theme" />
    <script>
        (function () {
            var root = document.documentElement;
            try {
                var theme = localStorage.getItem("vaka-theme");
                if (theme !== "dark" && theme !== "light") {
                    theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
                }
                root.dataset.theme = theme;
                if (localStorage.getItem("vaka-rail") === "collapsed") { root.dataset.rail = "collapsed"; }
            } catch (error) { }
            if (navigator.onLine === false) { root.dataset.online = "false"; }
        })();
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/HankenGrotesk-Latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Archivo-Latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <script type="module" src="~/js/App.js" asp-append-version="true" defer></script>
</head>
<body>
    <a class="skip-link" href="#main">İçeriğe geç</a>

    <div class="@(showRail ? "shell" : "min-h-[100dvh]")">
        @if (showRail)
        {
            <aside class="rail" aria-label="Kenar çubuğu">
                <div class="rail-brand">
                    <span class="brand-mark" aria-hidden="true"><svg class="icon icon-lg"><use href="/lib/icons/Icons.svg#droplets" /></svg></span>
                    <span class="brand-name">Vaka</span>
                </div>
                <nav class="rail-nav" aria-label="Ana menü">
                    <partial name="_NavList" model="navItems" />
                </nav>
                <div class="rail-foot">
                    <div class="rail-person">
                        <span class="person-avatar" aria-hidden="true">@initials</span>
                        <span class="rail-person-text">
                            <span class="person-name">@personName</span>
                            <span class="person-meta">Sicil @registryNo</span>
                            <span class="person-meta">@roleLabel</span>
                        </span>
                    </div>
                    <partial name="_SwitchUser" model='("rail", (string?)null)' />
                    <button type="button" class="btn btn-quiet btn-block" data-rail-toggle aria-expanded="true">
                        <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#panel-left-close" /></svg>
                        <span class="nav-label">Daralt</span>
                    </button>
                </div>
            </aside>
        }

        <div class="flex min-w-0 flex-col @(showRail ? "" : "min-h-[100dvh]")">
            <header class="topbar">
                @if (showRail)
                {
                    <a class="brand-mark h-11 w-11 lg:hidden max-[359px]:hidden" href="@homeHref" aria-label="Vaka ana sayfa">
                        <svg class="icon icon-lg" aria-hidden="true"><use href="/lib/icons/Icons.svg#droplets" /></svg>
                    </a>
                }
                else
                {
                    <span class="flex shrink-0 items-center gap-3 max-[359px]:hidden">
                        <span class="brand-mark" aria-hidden="true"><svg class="icon icon-lg"><use href="/lib/icons/Icons.svg#droplets" /></svg></span>
                        <span class="brand-name max-sm:sr-only">Vaka</span>
                    </span>
                }
                @if (showPerson)
                {
                    <div class="person-chip">
                        <span class="person-avatar max-sm:hidden lg:hidden" aria-hidden="true">@initials</span>
                        <span class="min-w-0">
                            <span class="person-name">@personName</span>
                            <span class="person-meta">Sicil @registryNo</span>
                        </span>
                    </div>
                    <partial name="_SwitchUser" model='(isFocus ? "bar-always" : "bar", (string?)null)' />
                }
                else
                {
                    <div class="flex-1"></div>
                }
                <partial name="_TopbarTools" />
            </header>

            <div class="conn-banner" role="alert">
                <svg class="icon mt-0.5" aria-hidden="true"><use href="/lib/icons/Icons.svg#wifi-off" /></svg>
                <p class="font-semibold">Bağlantı yok. Kayıt, onay ve kullanıcı değiştirme yapılamaz. Bağlantı gelince bu uyarı kapanır, işlemi yeniden yapın.</p>
            </div>

            <main id="main" class="page @(showRail || isFocus ? "" : "page-public")" tabindex="-1">
                <div class="page-head">
                    <div class="min-w-0">
                        <h1 class="page-title">@ViewData["Title"]</h1>
                        @if (ViewData["Lead"] is string lead)
                        {
                            <p class="page-lead">@lead</p>
                        }
                    </div>
                    @await RenderSectionAsync("Actions", required: false)
                </div>

                <div aria-live="polite" role="status">
                    @if (!string.IsNullOrEmpty(statusMessage))
                    {
                        <p class="notice notice-info mb-5">
                            <svg class="icon mt-0.5" aria-hidden="true"><use href="/lib/icons/Icons.svg#info" /></svg>
                            <span>@statusMessage</span>
                        </p>
                    }
                </div>

                @RenderBody()
            </main>
        </div>
    </div>

    @if (showRail)
    {
        <nav class="bottom-bar" aria-label="Alt gezinme">
            @foreach (var item in bottomItems)
            {
                <a class="bottom-link" href="@item.Href" aria-current="@(item.Key == currentKey ? "page" : null)">
                    <svg class="icon icon-lg" aria-hidden="true"><use href="/lib/icons/Icons.svg#@item.Icon" /></svg>
                    <span>@item.Label</span>
                </a>
            }
            <a class="bottom-link" href="#menu" data-drawer-open aria-controls="menu" aria-expanded="false">
                <svg class="icon icon-lg" aria-hidden="true"><use href="/lib/icons/Icons.svg#menu" /></svg>
                <span>Menü</span>
            </a>
        </nav>

        <div id="menu" class="drawer" data-drawer role="dialog" aria-modal="true" aria-label="Menü">
            <a class="drawer-scrim" href="#main" tabindex="-1" aria-label="Menüyü kapat" data-drawer-close></a>
            <div class="drawer-panel">
                <div class="rail-brand justify-between">
                    <span class="flex items-center gap-3">
                        <span class="brand-mark" aria-hidden="true"><svg class="icon icon-lg"><use href="/lib/icons/Icons.svg#droplets" /></svg></span>
                        <span class="brand-name">Vaka</span>
                    </span>
                    <a class="icon-btn" href="#main" data-drawer-close aria-label="Menüyü kapat">
                        <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#x" /></svg>
                    </a>
                </div>
                <nav class="rail-nav" aria-label="Tüm menü">
                    <partial name="_NavList" model="navItems" />
                </nav>
                <div class="drawer-foot">
                    <div class="flex items-center gap-3">
                        <span class="person-avatar" aria-hidden="true">@initials</span>
                        <span class="min-w-0">
                            <span class="person-name">@personName</span>
                            <span class="person-meta">Sicil @registryNo</span>
                            <span class="person-meta">@roleLabel</span>
                        </span>
                    </div>
                    <partial name="_SwitchUser" model='("drawer", (string?)null)' />
                </div>
            </div>
        </div>
    }
</body>
</html>

@model IReadOnlyList<(string Group, string Label, string Icon, string? Href, string Key)>
@{
    var currentKey = ViewData["NavKey"] as string ?? "";
    var lastGroup = "";
}
<ul class="space-y-1">
    @foreach (var item in Model)
    {
        if (item.Group != lastGroup)
        {
            lastGroup = item.Group;
            <li class="nav-group-title" role="presentation">@item.Group</li>
        }
        <li>
            @if (item.Href is null)
            {
                <span class="nav-link" aria-disabled="true" title="Sonraki fazda">
                    <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#@item.Icon" /></svg>
                    <span class="nav-label">@item.Label</span>
                </span>
            }
            else
            {
                <a class="nav-link" href="@item.Href" title="@item.Label" aria-current="@(item.Key == currentKey ? "page" : null)">
                    <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#@item.Icon" /></svg>
                    <span class="nav-label">@item.Label</span>
                </a>
            }
        </li>
    }
</ul>

@using Vaka.Web.ViewModels.Definitions
@model MaterialLotFormViewModel
@{
    var isCreate = Model.Id is null;
    ViewData["Title"] = isCreate ? "Lot ekle" : "Lotu düzenle";
    ViewData["Lead"] = Model.MaterialName + (isCreate ? " malzemesine yeni lot." : ", lot " + Model.LotNo);
    ViewData["NavKey"] = "materials";
}

<partial name="_FormSummary" model='isCreate ? "Lot eklenemedi" : "Lot kaydedilemedi"' />

<div class="grid items-start gap-5 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <form method="post" class="panel min-w-0" data-validate data-busy-form data-unsaved-guard aria-labelledby="lot-form-title">
        <div class="panel-head">
            <h2 id="lot-form-title" class="panel-title">Lot bilgileri</h2>
        </div>
        <div class="panel-body space-y-6">
            <input type="hidden" name="MaterialId" value="@Model.MaterialId" />
            <dl class="kv">
                <div><dt>Malzeme</dt><dd>@Model.MaterialName</dd></div>
            </dl>

            <div class="grid gap-5 md:grid-cols-2">
                <partial name="_Field" model='("LotNo", "Lot no", Model.LotNo, "text", "off", "Malzeme içinde benzersizdir.", true, false)' />
                <partial name="_ValueField" model='("ExpiryDate", "Son kullanma tarihi", "date", Model.ExpiryDate?.ToString("yyyy-MM-dd"), "Bu tarihten sonraki gün lot SKT geçmiş sayılır.", "Son kullanma tarihini girin.")' />
            </div>

            <div class="flex flex-wrap items-center gap-3 border-t-2 border-line pt-5">
                <button type="submit" class="btn btn-primary btn-lg" data-requires-online>
                    <svg class="icon" aria-hidden="true"><use href="/lib/icons/Icons.svg#save" /></svg>
                    @(isCreate ? "Lotu ekle" : "Değişiklikleri kaydet")
                </button>
                <a class="btn btn-secondary btn-lg" href="/materials/details/@Model.MaterialId">Vazgeç</a>
            </div>
        </div>
    </form>

    <aside class="min-w-0" aria-label="Bilgi">
        <section class="panel" aria-labelledby="lot-help-title">
            <div class="panel-head"><h2 id="lot-help-title" class="panel-title">Bilmeniz gerekenler</h2></div>
            <ul class="list-inside list-disc space-y-2 p-4 md:p-5">
                <li>Son kullanma tarihi bugün olan lot geçerlidir.</li>
                <li>SKT'si geçmiş lot listede işaretli kalır.</li>
            </ul>
        </section>
    </aside>
</div>
